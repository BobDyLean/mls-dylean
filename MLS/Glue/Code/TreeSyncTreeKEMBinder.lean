module

public import MLS.TreeSync.Code.Types
public import MLS.TreeKEM.Code.Types
public import MLS.Common.Code.Crypto.Derived

/-!
Port of `MLS.TreeSyncTreeKEMBinder`.
-/

namespace MLS

open Comparse
open MLS.TreeSync MLS.TreeKEM

variable {Bytes: Type} [CryptoBytes Bytes]

/-- Port of `treesync_to_treekem_node`. -/
@[expose]
public
def treesyncToTreekemNode (node: ParentNode Bytes tkt): TreeKEMNode Bytes :=
  {
    publicKey := node.content.val
    unmergedLeaves := node.unmergedLeaves.val.map UInt32.toNat
  }

/--
Port of `treesync_to_treekem`.
This does not contain any internal TreeKEM data. To be used then joining a new group.
-/
@[expose]
public
def treesyncToTreekem {l: Nat} (t: TreeSync Bytes tkt l): TreeKEM Bytes l :=
  match t.intoLeftRightView with
  | .leaf none position =>
    (LeftRightView.leaf none position).pack
  | .leaf (some lp) position =>
    (LeftRightView.leaf (some { publicKey := lp.data.content.val }) position).pack
  | .node onp left right =>
    let tkLeft := treesyncToTreekem left
    let tkRight := treesyncToTreekem right
    (LeftRightView.node (onp.map treesyncToTreekemNode) tkLeft tkRight).pack
termination_by l

/--
Port of `treekem_to_treesync`.
This function is used to authenticate data generated by TreeKEM. It allows TreeSync to handle parent hash + signature.
-/
@[expose]
public
def treekemToTreesync: {l: Nat} → (newLeafPackage: LeafNodeData Bytes tkt) → PrePathKEM Bytes l →
  Result (ExternalPathSync Bytes tkt l)
  | _, newLeafPackage, .leaf mi => do
    let content ← mkMlsBytes mi.publicKey "treekem_to_treesync" "content"
    pure (.leaf { newLeafPackage with content })
  | _, newLeafPackage, .node okp pkNext => do
    let next ← treekemToTreesync newLeafPackage pkNext
    pure (.node okp next)

end MLS
