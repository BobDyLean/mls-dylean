module

public import MLS.Symbolic.Code.Symbolic
public import MLS.Bootstrap.Code.KeyPackageRef
public import MLS.Bootstrap.Symbolic.State.InitKey

/-!
Port of `MLS.Bootstrap.Symbolic.State.KeyPackageStore`:
the store of the key packages generated by a principal, with the handles of their private states.

Port-specific differences:
- The state is a DyLean local state, with its own trace entry type
  (`PersistentLocalState.CompromisableState.ExecEntryT KeyPackageStorePre`): it has no tag.
- States are identified by handles instead of session identifiers.
  DyLean's states are immutable: `extendKeyPackageStore` stores a new version of the store, and returns its handle.
- The `*_post` types have no format, since they are not stored.
- The invariants and the proofs are not ported yet.
-/

namespace MLS.Bootstrap

open Comparse
open DY DY.Comparse
open MLS

variable [HasSymbolicBytes]

/-! ## Types -/

/-- Port of `key_package_store_key`. -/
public
structure KeyPackageStoreKey where
  keyPackageRef: Bytes

namespace KeyPackageStoreKey

public
def f: Bytes → KeyPackageStoreKey :=
  fun keyPackageRef => { keyPackageRef }

public
def g: KeyPackageStoreKey → Bytes :=
  fun x => x.keyPackageRef

public
instance: LeftInverse g f := ⟨by intro _; rfl⟩
public
instance: RightInverse g f := ⟨by intro _; rfl⟩

end KeyPackageStoreKey

/-- Port of `ps_key_package_store_key`. -/
public
def KeyPackageStoreKey.mf: NonExtensibleMessageFormat Bytes KeyPackageStoreKey :=
  .isomorphic .slowBytes KeyPackageStoreKey.f KeyPackageStoreKey.g
deriving NonExtensibleMessageFormat.IsNonAmbiguous, NonExtensibleMessageFormat.HasUniqueRepresentation, NonExtensibleMessageFormat.ParseConsumes

/-- Port of `ps_key_package_store_key_is_well_formed`. -/
@[simp]
public
theorem KeyPackageStoreKey.mf.wf_eq (pred: Bytes → Prop) [BytesCompatiblePred pred] (x: KeyPackageStoreKey):
  KeyPackageStoreKey.mf.wf pred x = pred x.keyPackageRef
:= by
  simp [KeyPackageStoreKey.mf, KeyPackageStoreKey.g]

/-- Port of `key_package_store_value_pre`. -/
public
structure KeyPackageStoreValuePre where
  keyPackage: KeyPackage Bytes TreeKEM.tkt
  signatureKeySid: Nat
  leafNodeKeySid: Nat
  initKeySid: Nat

namespace KeyPackageStoreValuePre

public
def f: KeyPackage Bytes TreeKEM.tkt × Nat × Nat × Nat → KeyPackageStoreValuePre :=
  fun (keyPackage, signatureKeySid, leafNodeKeySid, initKeySid) => { keyPackage, signatureKeySid, leafNodeKeySid, initKeySid }

public
def g: KeyPackageStoreValuePre → KeyPackage Bytes TreeKEM.tkt × Nat × Nat × Nat :=
  fun { keyPackage, signatureKeySid, leafNodeKeySid, initKeySid } => (keyPackage, signatureKeySid, leafNodeKeySid, initKeySid)

public
instance: LeftInverse g f := ⟨by intro _; rfl⟩
public
instance: RightInverse g f := ⟨by intro _; rfl⟩

end KeyPackageStoreValuePre

/-- Port of `ps_key_package_store_value_pre`. -/
public
def KeyPackageStoreValuePre.mf: NonExtensibleMessageFormat Bytes KeyPackageStoreValuePre :=
  .isomorphic (.prod (KeyPackage.mf TreeKEM.tkt) (.prod .slowNat (.prod .slowNat .slowNat)))
    KeyPackageStoreValuePre.f KeyPackageStoreValuePre.g
deriving NonExtensibleMessageFormat.IsNonAmbiguous, NonExtensibleMessageFormat.HasUniqueRepresentation, NonExtensibleMessageFormat.ParseConsumes

/-- Port of `ps_key_package_store_value_pre_is_well_formed`. -/
@[simp]
public
theorem KeyPackageStoreValuePre.mf.wf_eq (pred: Bytes → Prop) [BytesCompatiblePred pred] (x: KeyPackageStoreValuePre):
  KeyPackageStoreValuePre.mf.wf pred x = (KeyPackage.mf TreeKEM.tkt).wf pred x.keyPackage
:= by
  simp [KeyPackageStoreValuePre.mf, KeyPackageStoreValuePre.g]

/-- Port of `key_package_store_elem_pre`. -/
public
structure KeyPackageStoreElemPre where
  key: KeyPackageStoreKey
  value: KeyPackageStoreValuePre

namespace KeyPackageStoreElemPre

public
def f: KeyPackageStoreKey × KeyPackageStoreValuePre → KeyPackageStoreElemPre :=
  fun (key, value) => { key, value }

public
def g: KeyPackageStoreElemPre → KeyPackageStoreKey × KeyPackageStoreValuePre :=
  fun { key, value } => (key, value)

public
instance: LeftInverse g f := ⟨by intro _; rfl⟩
public
instance: RightInverse g f := ⟨by intro _; rfl⟩

end KeyPackageStoreElemPre

/-- Port of `ps_key_package_store_elem_pre`. -/
public
def KeyPackageStoreElemPre.mf: NonExtensibleMessageFormat Bytes KeyPackageStoreElemPre :=
  .isomorphic (.prod KeyPackageStoreKey.mf KeyPackageStoreValuePre.mf) KeyPackageStoreElemPre.f KeyPackageStoreElemPre.g
deriving NonExtensibleMessageFormat.IsNonAmbiguous, NonExtensibleMessageFormat.HasUniqueRepresentation, NonExtensibleMessageFormat.ParseConsumes

/-- Port of `ps_key_package_store_elem_pre_is_well_formed`. -/
@[simp]
public
theorem KeyPackageStoreElemPre.mf.wf_eq (pred: Bytes → Prop) [BytesCompatiblePred pred] (x: KeyPackageStoreElemPre):
  KeyPackageStoreElemPre.mf.wf pred x = (KeyPackageStoreKey.mf.wf pred x.key ∧ KeyPackageStoreValuePre.mf.wf pred x.value)
:= by
  simp only [KeyPackageStoreElemPre.mf, NonExtensibleMessageFormat.isomorphic.wf_eq, KeyPackageStoreElemPre.g,
    NonExtensibleMessageFormat.prod.wf_eq]

/-- Port of `key_package_store_pre`. -/
public
structure KeyPackageStorePre where
  elems: List KeyPackageStoreElemPre

namespace KeyPackageStorePre

public
def f: List KeyPackageStoreElemPre → KeyPackageStorePre :=
  fun l => { elems := l }

public
def g: KeyPackageStorePre → List KeyPackageStoreElemPre :=
  fun x => x.elems

public
instance: LeftInverse g f := ⟨by intro _; rfl⟩
public
instance: RightInverse g f := ⟨by intro _; rfl⟩

end KeyPackageStorePre

/-- Port of `ps_key_package_store_pre`. -/
public
def KeyPackageStorePre.mf: NonExtensibleMessageFormat Bytes KeyPackageStorePre :=
  .isomorphic (.slowList KeyPackageStoreElemPre.mf) KeyPackageStorePre.f KeyPackageStorePre.g
deriving NonExtensibleMessageFormat.IsNonAmbiguous, NonExtensibleMessageFormat.HasUniqueRepresentation, NonExtensibleMessageFormat.ParseConsumes

/-- Port of `ps_key_package_store_pre_is_well_formed`. -/
@[simp]
public
theorem KeyPackageStorePre.mf.wf_eq (pred: Bytes → Prop) [BytesCompatiblePred pred] (x: KeyPackageStorePre):
  KeyPackageStorePre.mf.wf pred x = ∀ y ∈ x.elems, KeyPackageStoreElemPre.mf.wf pred y
:= by
  simp [KeyPackageStorePre.mf, KeyPackageStorePre.g]

/-- Port of `local_state_bootstrap_key_package_store_state` (for its format). -/
public
instance KeyPackageStorePre.ps: ParseableSerializeableNE KeyPackageStorePre :=
  .make KeyPackageStorePre.mf

/-- Port of `key_package_store_value_post`. -/
public
structure KeyPackageStoreValuePost where
  keyPackage: KeyPackage Bytes TreeKEM.tkt
  signatureKeySid: Nat
  leafNodeKeySid: Nat
  initKey: Bytes

/-- Port of `key_package_store_elem_post`. -/
public
structure KeyPackageStoreElemPost where
  key: KeyPackageStoreKey
  value: KeyPackageStoreValuePost

/-! ## API -/

section API

variable [ExecTraceTypes]
variable [ExecTraceTypes.Has (PersistentLocalState.State.ExecEntryT BootstrapInitKeyState)]
variable [ExecTraceTypes.Has (PersistentLocalState.State.ExecEntryT KeyPackageStorePre)]

/-- Port of `key_package_store_value_pre_to_post`. -/
public
def keyPackageStoreValuePreToPost (me: Participant) (value: KeyPackageStoreValuePre): Traceful KeyPackageStoreValuePost := do
  let initKey ← getInitKeySk me value.initKeySid value.keyPackage.tbs.leafNode.data.content.val
  pure {
    keyPackage := value.keyPackage
    signatureKeySid := value.signatureKeySid
    leafNodeKeySid := value.leafNodeKeySid
    initKey
  }

/-- Port of `key_package_store_pre_to_post`. -/
public
def keyPackageStorePreToPost (me: Participant): List KeyPackageStoreElemPre → Traceful (List KeyPackageStoreElemPost)
  | [] => pure []
  | h :: t => do
    let hValuePost ← keyPackageStoreValuePreToPost me h.value
    let hPost: KeyPackageStoreElemPost := { key := h.key, value := hValuePost }
    let tPost ← keyPackageStorePreToPost me t
    pure (hPost :: tPost)

/-- Port of `lookup_key_package_store`. -/
public
def lookupKeyPackageStore (l: List KeyPackageStoreElemPost) (keyPackageRef: Bytes): Option KeyPackageStoreValuePost :=
  match l with
  | [] => none
  | h :: t =>
    if h.key.keyPackageRef = keyPackageRef then
      some h.value
    else
      lookupKeyPackageStore t keyPackageRef

/-- Port of `initialize_key_package_store`. Returns the handle of the new (empty) store. -/
public
def initializeKeyPackageStore (me: Participant): Traceful Nat :=
  PersistentLocalState.storeLocalState me ({ elems := [] }: KeyPackageStorePre)

/--
Port of `extend_key_package_store`.
Stores a new version of the store at `sid`, with the new value, and returns its handle.
-/
public
def extendKeyPackageStore (me: Participant) (sid: Nat) (value: KeyPackageStoreValuePre): Traceful Nat := do
  let keyPackageRef ← extractResult (computeKeyPackageRef value.keyPackage)
  let elem: KeyPackageStoreElemPre := {
    key := { keyPackageRef := keyPackageRef.val }
    value
  }
  let store: KeyPackageStorePre ← PersistentLocalState.getLocalState me sid
  PersistentLocalState.storeLocalState me ({ elems := elem :: store.elems }: KeyPackageStorePre)

/-- Port of `get_store_lookup_function`. -/
public
def getStoreLookupFunction (me: Participant) (sid: Nat): Traceful (Bytes → Option KeyPackageStoreValuePost) := do
  let storePre: KeyPackageStorePre ← PersistentLocalState.getLocalState me sid
  let storePost ← keyPackageStorePreToPost me storePre.elems
  pure (lookupKeyPackageStore storePost)

end API

/-- Port of `key_package_store_value_to_hpke_sk`. -/
public
def keyPackageStoreValueToHpkeSk (value: KeyPackageStoreValuePost): Result Bytes :=
  let res := value.initKey
  if BytesLike.length res ≠ CryptoBytes.hpkePrivateKeyLength Bytes then
    Result.error ""
  else
    pure res

/-- Port of `key_package_store_value_to_key_package`. -/
public
def keyPackageStoreValueToKeyPackage (value: KeyPackageStoreValuePost): KeyPackage Bytes TreeKEM.tkt :=
  value.keyPackage

end MLS.Bootstrap
