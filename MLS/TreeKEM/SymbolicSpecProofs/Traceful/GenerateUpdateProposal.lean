module

public import MLS.TreeKEM.SymbolicSpec.Traceful.GenerateUpdateProposal
public import MLS.TreeKEM.SymbolicSpecProofs.Traceful.GenerateKeyPackage
import all MLS.TreeKEM.SymbolicSpec.Traceful.GenerateUpdateProposal
import all MLS.TreeSync.SymbolicSpec.LeafNodeSignature
import DY.Meta.Step

/-!
Port of `MLS.TreeKEM.Symbolic.Traceful.GenerateUpdateProposal.Proof`.

Port-specific differences:
- The proofs are DyLean Hoare triples (instances), assuming the invariants of
  `MLS.TreeKEM.SymbolicSpecProofs.Traceful.AllInvariants` (MLS*'s `has_treesync_and_treekem_invariants`).
- The leaf node is generated by `generateUpdateLeafNode'` (see `MLS.TreeKEM.SymbolicSpec.Traceful.GenerateUpdateProposal`),
  whose proof follows the one of `_generate_leaf_node_proof`, with the tree event of the leaf.
  The precondition of `generateUpdateProposal'` states that the group identifier is publishable
  (it is signed in the leaf node); `generateUpdateProposal` gets it from the invariant of the group state.
-/

namespace MLS.TreeKEM

open Comparse
open DY DY.Comparse
open MLS MLS.TreeSync MLS.TreeDEM

variable [HasSymbolicInvariants] [TraceInvariant] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]
variable [HasTreesyncInvariants tkt] [HasTreeKEMProofTrace] [HasTreesyncTreekemLinkInvariants]

/-! ## Generate update proposal, proof -/

/-- Proof of `generateUpdateLeafNode'`, following `_generate_leaf_node_proof`. -/
@[instance]
public
theorem generateUpdateLeafNode'.proof (me: Participant) (leafNodeSkeleton: LeafNode Bytes tkt) (signatureKeySid: Nat)
  (groupId: MlsBytes Bytes) (leafIndex: Nat):
  HoareTriple
    (generateUpdateLeafNode' me leafNodeSkeleton signatureKeySid groupId leafIndex)
    (fun tr =>
      (LeafNode.mf tkt).wf (Bytes.Publishable · tr) leafNodeSkeleton ∧
      groupId.val.Publishable tr
    )
    (fun (leafNode, _leafNodeKeySid) tr =>
      (LeafNode.mf tkt).wf (Bytes.Publishable · tr) leafNode ∧
      credentialToPrincipal leafNode.data.credential = some me
    )
:= by
  unfold generateUpdateLeafNode'
  split
  · step
    split
    step
    step
    step
    step
    step
    step_intro
    step_intro
    step by
      rw [ProtocolEvent.EventInv.Has.invariant_eq (pred := leafNodeSignedEventPred)]
      simp only [leafNodeSignedEventPred, leafNodeTbs, leafNodeData, ‹leafNodeSkeleton.data.source = _›]
    step by
      rw [ProtocolEvent.EventInv.Has.invariant_eq_fun (pred := groupHasTreeEventPred)]
      intro tr' hle
      simp only [groupHasTreeEventPred, mkGroupHasTreeEvent, nodeSkLabelCanonNosig, canonicalizeUnmergedLeaves_zero,
        nodeSkLabelAux_zero, getNodeContent_zero, nodeNotBlank_zero, ChildSiblingView.leafContent_pack,
        ChildSiblingView.position_pack_leaf, Option.map_some, Option.getD_some, Option.isSome_some, nodeSkLabelAuxLeaf,
        leafNodeData, credentialToPrincipal_principalToCredential me credential ‹_›, ‹leafNodeSkeleton.data.source = _›,
        reduceCtorEq, ite_false, ite_true, true_and]
      have hk := (mkMlsBytes_eq_success _ _ _ _).1 ‹mkMlsBytes _ "_generate_update_leaf_node" "leaf_node_key" = _›
      have := IsNodePkForLeafPk_later tr tr' me _ _ hle ‹_ ∧ _›.1
      simp only [IsNodePkForLeafPk] at this
      refine ⟨by grind, ?_, by grind, by omega⟩
      grind [Label.canFlow]
    step by
      have := principalToCredential_wf tr me credential ‹_›
      have hsk := ‹(LeafNode.mf tkt).wf (Bytes.Publishable · tr) leafNodeSkeleton ∧ _›.1
      simp only [LeafNode.mf.wf_eq, LeafNodeData.mf.wf_eq] at hsk
      have hli: (UInt32.ofNat leafIndex).toNat = leafIndex := UInt32.toNat_ofNat_of_lt' ‹_›
      refine ⟨?_, by grind, ‹_›, by rw [hli]; assumption⟩
      simp only [leafNodeData, LeafNodeData.mf.wf_eq]
      grind [IsSignatureKeyVk, IsNodePkForLeafPk, mkMlsBytes_eq_success, tkt.mfLeafContent.wf_eq]
    step
    grind [credentialToPrincipal_principalToCredential]
  · apply HoareTriple.mk
    intro tr _ _
    simp only [WP.wp, Traceful.run_failure]
    exists tr

/--
Port of `_generate_update_proposal_proof`.
It also requires the group identifier of the group state to be publishable (see the module docstring).
-/
@[instance]
public
theorem generateUpdateProposal'.proof (me: Participant) (updateCacheSid: Nat) (st: TreeSyncTreeKEMState)
  (leafNodeSkeleton: LeafNode Bytes tkt) (signatureKeySid: Nat):
  HoareTriple
    (generateUpdateProposal' me updateCacheSid st leafNodeSkeleton signatureKeySid)
    (fun tr =>
      (LeafNode.mf tkt).wf (Bytes.Publishable · tr) leafNodeSkeleton ∧
      st.groupContext.groupId.val.Publishable tr
    )
    (fun (updateProposal, _updateCacheSid) tr => Proposal.mf.wf (Bytes.Publishable · tr) updateProposal)
:= by
  unfold generateUpdateProposal'
  step
  split
  step
  step
  simp only [Proposal.mf.wf_eq, Update.mf.wf_eq]
  grind

/-- Port of `generate_update_proposal_proof`. -/
@[instance]
public
theorem generateUpdateProposal.proof (me: Participant) (updateCacheSid: Nat) (groupStateSid: Nat)
  (leafNodeSkeletonTs: Nat) (signatureKeySid: Nat):
  HoareTriple
    (generateUpdateProposal me updateCacheSid groupStateSid leafNodeSkeletonTs signatureKeySid)
    (fun _ => True)
    (fun _ _ => True)
:= by
  unfold generateUpdateProposal
  step
  step
  split
  · step by
      refine ⟨wf_of_parse _ _ _ _ ‹_› ‹_›, ?_⟩
      have := ‹TreesyncTreekemStateAllInvariants tr me st›.1.2.2.2.2.1
      rw [GroupContext.mf.wf_eq] at this
      grind
    split
    step by
      exact (pred_serializeNE_iff _ _ _).2 ‹_›
    step
    trivial
  · simp only [WP.wp, Traceful.run_failure]
    exists tr

end MLS.TreeKEM
