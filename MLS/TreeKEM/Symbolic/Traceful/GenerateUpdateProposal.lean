module

public import MLS.TreeKEM.Symbolic.Traceful.GenerateKeyPackage

/-!
Port of `MLS.TreeKEM.Symbolic.Traceful.GenerateUpdateProposal`.

The function `generateUpdateProposal`
works similarly to `generateKeyPackage` in `MLS.TreeKEM.Symbolic.Traceful.GenerateKeyPackage`.
We receive a "leaf node skeleton" from the attacker,
and replace its credential, signature key, leaf node key, and signature
before sending it on the network bundled in an Update Proposal.

Port-specific differences:
- MLS*'s functions with a leading underscore (`_generate_update_proposal`) end with a prime.
- DyLean's states are immutable: the functions also return the new handle of the update cache.
- Unlike MLS*, the leaf node is generated by `generateUpdateLeafNode'` instead of `generateLeafNode'`
  (MLS*'s `_generate_leaf_node`). The latter requires the source `key_package`,
  whereas `prepare_update` requires the source `update` when the proposal is processed:
  in MLS*, the update proposals generated by honest participants cannot be committed.
  A leaf node with source `update` is signed with the group identifier and the leaf index of its owner,
  hence `generateUpdateProposal'` (resp. `generateUpdateProposal`) also takes the group state
  (resp. its handle).
-/

namespace MLS.TreeKEM

open Comparse
open DY DY.Comparse
open MLS MLS.TreeSync MLS.TreeDEM

variable [HasSymbolicBytes] [ExecTraceTypes] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/-! ## Generate update proposal -/

/--
Variant of `generateLeafNode'` (MLS*'s `_generate_leaf_node`) for leaf nodes with source `update`
(not in MLS*, see the module docstring):
the group identifier and the leaf index are part of the signed content.
-/
public
def generateUpdateLeafNode' (me: Participant) (leafNodeSkeleton: LeafNode Bytes tkt) (signatureKeySid: Nat)
  (groupId: MlsBytes Bytes) (leafIndex: Nat):
  Traceful (LeafNode Bytes tkt × Nat)
:= do
  let some credential := principalToCredential me | failure
  let (leafNodeKeySid, leafNodeKey) ← mkLeafNodeKey me
  let signatureKey ← getSignatureKeyVk me signatureKeySid
  guard (leafNodeSkeleton.data.source = .update)
  guard (leafIndex < 2^32)
  let leafNodeKey ← extractResult (mkMlsBytes leafNodeKey "_generate_update_leaf_node" "leaf_node_key")
  let signatureKey ← extractResult (mkMlsBytes signatureKey "_generate_update_leaf_node" "signature_key")
  let leafNodeData: LeafNodeData Bytes tkt := {
    leafNodeSkeleton.data with
    credential
    content := (leafNodeKey: HpkePublicKey Bytes)
    signatureKey
  }
  -- the source is `update`: the group identifier and leaf index are present
  let leafNodeTbs: LeafNodeTBS Bytes tkt := {
    data := leafNodeData
    groupId := StaticOption.mk groupId
    leafIndex := StaticOption.mk leafIndex.toUInt32
  }
  Symbolic.API.triggerLeafNodeEvent me leafNodeTbs
  let leafNode ← Symbolic.API.authenticateLeafNodeDataFromUpdate me signatureKeySid leafNodeData groupId leafIndex.toUInt32
  pure (leafNode, leafNodeKeySid)

/--
Port of `_generate_update_proposal`.
Returns the update proposal, and the new handle of the update cache.
Unlike MLS*, it takes the group state `st`, whose group identifier and leaf index are signed in the leaf node.
-/
public
def generateUpdateProposal' (me: Participant) (updateCacheSid: Nat) (st: TreeSyncTreeKEMState)
  (leafNodeSkeleton: LeafNode Bytes tkt) (signatureKeySid: Nat): Traceful (Proposal Bytes × Nat)
:= do
  let (leafNode, leafSkSid) ←
    generateUpdateLeafNode' me leafNodeSkeleton signatureKeySid st.groupContext.groupId st.leafIndex
  let updateCacheSid ← rememberUpdateLeafSk me updateCacheSid leafNode leafSkSid
  pure (.update { leafNode }, updateCacheSid)

/--
Port of `generate_update_proposal`.
Returns the handle of the update proposal message, and the new handle of the update cache.
Unlike MLS*, it takes the handle of the group state `groupStateSid` (see `generateUpdateProposal'`).
-/
public
def generateUpdateProposal (me: Participant) (updateCacheSid: Nat) (groupStateSid: Nat)
  (leafNodeSkeletonTs: Nat) (signatureKeySid: Nat): Traceful (Nat × Nat)
:= do
  let st ← getTreesyncTreekemState me groupStateSid
  let leafNodeSkeletonBytes ← Network.receiveMessage leafNodeSkeletonTs
  let some leafNodeSkeleton := (LeafNode.mf tkt).toExtensible.parse leafNodeSkeletonBytes | failure
  let (updateProposal, updateCacheSid) ← generateUpdateProposal' me updateCacheSid st leafNodeSkeleton signatureKeySid
  let updateProposalTs ← Network.sendMessage (serializeNE Proposal.mf updateProposal)
  pure (updateProposalTs, updateCacheSid)

end MLS.TreeKEM
