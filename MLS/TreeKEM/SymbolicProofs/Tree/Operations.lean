module

public import MLS.TreeKEM.SymbolicProofs.Tree.Labels
public import MLS.TreeKEM.Proofs.Invariants
public import MLS.Glue.Proofs.TreeSyncTreeKEMBinder
public import MLS.Common.SymbolicProofs.Crypto.Derived.ExpandWithLabel
public import MLS.Common.SymbolicProofs.Crypto.Derived.EncryptWithLabel
public import MLS.Symbolic.SymbolicProofs.Randomness
public import MLS.TreeKEM.Code.Parsers

/-!
Port of `MLS.TreeKEM.Symbolic.Tree.Operations`:
the labels and usages of the path secrets generated by a committer,
and the proofs that the TreeKEM operations (`generatePathSecrets`, `encryptPathSecrets`, `getPathSecret`, `pathApplyPath`, …)
preserve them.

Port-specific differences:
- The local ExpandWithLabel usages and EncryptWithLabel predicate are `ExpandWithLabelUsage.Local` / `EncryptWithLabelPred.Local`
  (see `MLS.Common.SymbolicProofs.Crypto.Derived.ExpandWithLabel`), and MLS*'s `has_mls_treekem_invariants`
  is the class `HasMlsTreekemInvariants`, whose fields are scoped instances in `MLS.TreeKEM`
  (it also contains HPKE's invariants, part of MLS*'s `has_mls_encryptwithlabel_pred`).
- Paths are not indexed by the leaf index: the predicates on paths (`PathSecretsAreCorrect`, …) take the leaf index `li`
  right after the tree, and recurse on the path, using the child / sibling of the tree for `li`.
- The TreeSync and TreeKEM trees are related by `treesyncTreekemRel`, i.e. `tk = treesyncToTreekem ts`.
- Lemmas about functions returning a `Result` take the result and the success hypothesis
  (MLS*'s `match … with | Success … -> … | _ -> True`).
- `for_allP p l` is `∀ x ∈ l, p x`.
- TreeKEM's `treeResolution` and `unmergedLeavesResolution` skip the unmerged leaves that are not leaves of the tree:
  the lemmas about resolutions do not need `treekem_invariant`.
- `encrypt_path_secrets` takes the un-added tree (`unAddP tk pre` in MLS*) as argument (see `MLS.TreeKEM.Operations`):
  the ghost data of its randomness (`encryptPathSecretsEntropyGhostData`) takes it as well,
  and only counts the randomness of the nodes with a path secret (as MLS*'s `forget_path_secrets`).
-/

namespace MLS.TreeKEM

open Comparse
open DY DY.Comparse
open DySlop DySlop.HPKE DySlop.SplitFunction
open MLS MLS.TreeSync

/-! ## Usages and predicates -/

section Usages

variable [HasSymbolicBytes] [ExecTraceTypes] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/-- Port of `one_path_secret_usage_to_path_secret_label`. -/
@[expose]
public
def onePathSecretUsageToPathSecretLabel (x: OnePathSecretUsage): Label :=
  nodeSkLabelNosig x.t x.groupId x.committerLeafIndex

/-- The label of the first path secret usage (MLS*'s `if Cons? x then one_path_secret_usage_to_path_secret_label (List.Tot.hd x) else secret`). -/
@[expose]
public
def PathSecretUsage.headLabel: PathSecretUsage → Label
  | [] => Label.secret
  | h :: _ => onePathSecretUsageToPathSecretLabel h

/-- Port of `expand_usage_path_secret_path`. -/
@[expose]
public
def expandUsagePathSecretPath: ExpandWithLabelUsage.Local ["path"] :=
  .single {
    getUsage prkUsage _ _ :=
      match PathSecretUsage.ofUsage prkUsage with
      | none => Usage.kdfExpandKey "MLS.PathSecret" BytesLike.empty
      | some [] => PathSecretUsage.toUsage []
      | some (_ :: t) => PathSecretUsage.toUsage t
    getLabel prkUsage prkLabel _ _ :=
      match PathSecretUsage.ofUsage prkUsage with
      | none => prkLabel
      | some [] => prkLabel
      | some (h :: _) => prkLabel.join (onePathSecretUsageToPathSecretLabel h)
    getLabel_lemma tr prkUsage prkLabel _ _ _ := by
      split
      · grind
      · grind
      · grind
  }

/-- Port of `expand_usage_path_secret_node`. -/
@[expose]
public
def expandUsagePathSecretNode: ExpandWithLabelUsage.Local ["node"] :=
  .single (.secret nodeKeyUsage)

end Usages

section Predicates

variable [HasSymbolicBytes] [ExecTraceTypes] [ProofTraceTypes]

/-- Port of `mls_hpke_updatepathnode_pred`. -/
@[expose]
public
def mlsHpkeUpdatepathnodePred: EncryptWithLabelPred.Local ["UpdatePathNode"] :=
  .single { pred _ msg _ tr := ∃ data, msg.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr }

/-- Port of the `pred_later` field of `mls_hpke_updatepathnode_pred`. -/
public
theorem mlsHpkeUpdatepathnodePredProof [BytesInvariants]: EncryptWithLabelPred.LocalProof mlsHpkeUpdatepathnodePred :=
  EncryptWithLabelPred.LocalProof.single fun _ msg _ tr1 tr2 hmsg _ hle ⟨data, h⟩ =>
    ⟨data, Bytes.HasUsage_later msg _ tr1 tr2 hmsg hle h⟩

theorem mlsHpkeUpdatepathnodePred_pred [BytesInvariants] (msg context: Bytes) (tr: ProofTrace):
  mlsHpkeUpdatepathnodePred.pred "UpdatePathNode" BytesLike.empty msg context tr ↔
    ∃ data, msg.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr
:= by
  simp [mlsHpkeUpdatepathnodePred, EncryptWithLabelPred.Local.pred_single]

end Predicates

section Invariants

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/--
Port of `has_mls_treekem_invariants`
(with HPKE's invariants, part of MLS*'s `has_mls_encryptwithlabel_pred`).
The fields are scoped instances in the namespace `MLS.TreeKEM`; the top-level protocol provides them
(`instance: HasMlsTreekemInvariants where`).
-/
public
class HasMlsTreekemInvariants: Prop where
  [expandPath: ExpandWithLabelUsage.Has "MLS.PathSecret" expandUsagePathSecretPath]
  [expandNode: ExpandWithLabelUsage.Has "MLS.PathSecret" expandUsagePathSecretNode]
  [encryptUpdatePathNode: EncryptWithLabelPred.Has "MLS.NodeHpkeKey" mlsHpkeUpdatepathnodePred]
  [hpkeKdfExpand: KdfExpand.KdfExpandUsage.Has HPKE.kdfExpandUsage]
  [hpkeAead: Aead.AeadPred.Has HPKE.aeadPred]

attribute [scoped instance] HasMlsTreekemInvariants.expandPath
attribute [scoped instance] HasMlsTreekemInvariants.expandNode
attribute [scoped instance] HasMlsTreekemInvariants.encryptUpdatePathNode
attribute [scoped instance] HasMlsTreekemInvariants.hpkeKdfExpand
attribute [scoped instance] HasMlsTreekemInvariants.hpkeAead

end Invariants

/-! ## Path secret usages -/

section PathSecretUsage

variable [HasSymbolicBytes]

/--
Port of `compute_path_secret_usage`.
MLS* requires `li: leaf_index l i` (i.e. `t.containsLeafIndex li`);
otherwise, the function follows the path to the leaf closest to `li`.
-/
@[expose]
public
def computePathSecretUsage {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (acc: PathSecretUsage):
  PathSecretUsage
:=
  match t.intoChildSiblingView li with
  | .leaf _ _ => acc
  | .node _ child sibling =>
    if !isTreeEmpty sibling then
      computePathSecretUsage child groupId li ({ l := _, t := sibling, groupId, committerLeafIndex := li } :: acc)
    else
      computePathSecretUsage child groupId li acc
termination_by l

theorem computePathSecretUsage_zero (t: TreeSync Bytes tkt 0) (groupId: MlsBytes Bytes) (li: Nat) (acc: PathSecretUsage):
  computePathSecretUsage t groupId li acc = acc
:= by
  rw [computePathSecretUsage.eq_def]
  grind

theorem computePathSecretUsage_succ {l: Nat} (t: TreeSync Bytes tkt (l+1)) (groupId: MlsBytes Bytes) (li: Nat)
  (acc: PathSecretUsage):
  computePathSecretUsage t groupId li acc =
    computePathSecretUsage (t.child li) groupId li
      (if !isTreeEmpty (t.sibling li) then { l := l, t := t.sibling li, groupId, committerLeafIndex := li } :: acc else acc)
:= by
  rw [computePathSecretUsage.eq_def]
  grind

end PathSecretUsage

/-! ## Code lemmas -/

section Code

variable [HasSymbolicBytes]

theorem deriveKeypairFromPathSecret_eq_success (pathSecret sk pk: Bytes)
  (h: deriveKeypairFromPathSecret pathSecret = .success (sk, pk)):
  expandWithLabel pathSecret "node" BytesLike.empty 32 = .success sk ∧ pk = hpkePk sk
:= by
  simp only [deriveKeypairFromPathSecret, Result.bind_eq_success] at h
  obtain ⟨nodeSecret, h1, h2⟩ := h
  simp only [CryptoBytes.hpkeGenKeypair] at h2
  split at h2
  · simp [Result.error] at h2
  · simp only [Result.pure_eq_success] at h2
    obtain ⟨rfl, rfl⟩ := h2
    exact ⟨h1, rfl⟩

theorem deriveNextPathSecret_eq (pathSecret: Bytes):
  deriveNextPathSecret pathSecret = expandWithLabel pathSecret "path" BytesLike.empty 32
:= rfl

theorem generatePathSecrets_node {l: Nat} (t: TreeKEM Bytes (l+1)) (leafSk pathSecret0: Bytes) (li: Nat)
  (p: PathSecrets Bytes (l+1)) (pathSecretN: Bytes)
  (h: generatePathSecrets t leafSk pathSecret0 li = .success (p, pathSecretN)):
  ∃ pNext myPathSecret,
    generatePathSecrets (t.child li) leafSk pathSecret0 li = .success (pNext, myPathSecret) ∧
    if isTreeEmpty (t.sibling li) then
      p = .node none pNext ∧ pathSecretN = myPathSecret
    else
      p = .node (some myPathSecret) pNext ∧ deriveNextPathSecret myPathSecret = .success pathSecretN
:= by
  rw [generatePathSecrets.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq, Result.bind_eq_success] at h
  obtain ⟨⟨pNext, myPathSecret⟩, h1, h2⟩ := h
  refine ⟨pNext, myPathSecret, h1, ?_⟩
  split at h2 <;> simp_all

theorem generatePathSecrets_zero (t: TreeKEM Bytes 0) (leafSk pathSecret0: Bytes) (li: Nat)
  (p: PathSecrets Bytes 0) (pathSecretN: Bytes)
  (h: generatePathSecrets t leafSk pathSecret0 li = .success (p, pathSecretN)):
  p = .leaf leafSk ∧ pathSecretN = pathSecret0
:= by
  rw [generatePathSecrets.eq_def] at h
  simp only [Tree.intoChildSiblingView_zero, Result.pure_eq_success] at h
  grind

/-- The public key generated from a leaf private key. -/
theorem hpkeGenKeypair_eq_success (sk sk' pk: Bytes) (h: CryptoBytes.hpkeGenKeypair sk = .success (sk', pk)):
  sk' = sk ∧ pk = hpkePk sk
:= by
  simp only [CryptoBytes.hpkeGenKeypair] at h
  split at h
  · simp [Result.error] at h
  · simp only [Result.pure_eq_success] at h
    grind

omit [HasSymbolicBytes] in
theorem destRandomness_eq_success {Bytes: Type} (rand: Randomness Bytes) (randCur: Bytes) (randNext: Randomness Bytes):
  destRandomness rand = .success (randCur, randNext) ↔ rand.rand = randCur :: randNext.rand
:= by
  obtain ⟨_ | ⟨head, tail⟩⟩ := rand
  · simp [destRandomness, Result.internalFailure]
  · obtain ⟨rn⟩ := randNext
    simp [destRandomness]

theorem multiEncryptWithLabel_cons (pk: Bytes) (pks: List Bytes) (label: String) (context plaintext: Bytes)
  (rand: Randomness Bytes) (res: List (HpkeCiphertext Bytes))
  (h: multiEncryptWithLabel (pk :: pks) label context plaintext rand = .success res):
  ∃ randCur randNext kemOutput ciphertext c resTl,
    rand.rand = randCur :: randNext.rand ∧
    encryptWithLabel pk label context plaintext randCur = .success (kemOutput, ciphertext) ∧
    multiEncryptWithLabel pks label context plaintext randNext = .success resTl ∧
    res = c :: resTl ∧ c.kemOutput.val = kemOutput ∧ c.ciphertext.val = ciphertext
:= by
  simp only [multiEncryptWithLabel, Result.bind_eq_success, mkMlsBytes_eq_success, Result.pure_eq_success] at h
  obtain ⟨⟨randCur, randNext⟩, hdest, pk', hpk, ⟨kemOutput, ciphertext⟩, henc, kemOutput', rfl, ciphertext', rfl, resTl, hrec, rfl⟩ := h
  have: pk' = pk := by
    unfold mkHpkePublicKey at hpk
    split at hpk <;> simp_all [Result.error]
  subst this
  exact ⟨randCur, randNext, _, _, _, resTl, (destRandomness_eq_success _ _ _).mp hdest, henc, hrec, rfl, rfl, rfl⟩

theorem encryptPathSecrets_leaf (t: TreeKEM Bytes 0) (li: Nat) (leafIkm: Bytes) (groupContext: GroupContext Bytes)
  (rand: Randomness Bytes) (res: PathKEM Bytes 0) (priv: TreeKEMPriv Bytes 0)
  (h: encryptPathSecrets t li (.leaf leafIkm) groupContext rand = .success (res, priv)):
  res = .leaf { publicKey := hpkePk leafIkm } ∧ priv = .leaf leafIkm
:= by
  rw [encryptPathSecrets.eq_def] at h
  simp only [Tree.intoChildSiblingView_zero, Result.bind_eq_success, Result.pure_eq_success] at h
  obtain ⟨⟨sk, pk⟩, hgen, h⟩ := h
  obtain ⟨rfl, rfl⟩ := hpkeGenKeypair_eq_success _ _ _ hgen
  grind

theorem encryptPathSecrets_node_none {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (pNext: PathSecrets Bytes l)
  (groupContext: GroupContext Bytes) (rand: Randomness Bytes) (res: PathKEM Bytes (l+1)) (priv: TreeKEMPriv Bytes (l+1))
  (h: encryptPathSecrets t li (.node none pNext) groupContext rand = .success (res, priv)):
  ∃ resNext privNext,
    encryptPathSecrets (t.child li) li pNext groupContext rand = .success (resNext, privNext) ∧
    res = .node none resNext ∧ priv = .node none privNext
:= by
  rw [encryptPathSecrets.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq, Result.bind_eq_success, Result.pure_eq_success] at h
  grind

theorem encryptPathSecrets_node_some {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (pathSecret: Bytes) (pNext: PathSecrets Bytes l)
  (groupContext: GroupContext Bytes) (rand: Randomness Bytes) (res: PathKEM Bytes (l+1)) (priv: TreeKEMPriv Bytes (l+1))
  (h: encryptPathSecrets t li (.node (some pathSecret) pNext) groupContext rand = .success (res, priv)):
  ∃ randCur randNext resNext privNext ciphertexts sk pk,
    splitRandomness (multiEncryptWithLabelEntropyLengths (treeResolution (t.sibling li))) rand = .success (randCur, randNext) ∧
    encryptPathSecrets (t.child li) li pNext groupContext randNext = .success (resNext, privNext) ∧
    multiEncryptWithLabel (treeResolution (t.sibling li)) "UpdatePathNode" (serializeNE GroupContext.mf groupContext)
      pathSecret randCur = .success ciphertexts ∧
    deriveKeypairFromPathSecret pathSecret = .success (sk, pk) ∧
    ∃ upn: UpdatePathNode Bytes, upn.encryptionKey.val = pk ∧ upn.encryptedPathSecret.val = ciphertexts ∧
      res = .node (some upn) resNext ∧ priv = .node (some sk) privNext
:= by
  rw [encryptPathSecrets.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq, Result.bind_eq_success, Result.pure_eq_success, mkMlsBytes_eq_success,
    mkMlsList_eq_success] at h
  grind

theorem getPathSecretOfAddedLeaf_node {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (opn: Option Bytes)
  (pNext: PathSecrets Bytes l) (leafLi: Nat) (pathSecret: Bytes)
  (h: getPathSecretOfAddedLeaf t li (.node opn pNext) leafLi = .success pathSecret):
  t.containsLeafIndex leafLi ∧
  ((t.child li).containsLeafIndex leafLi → getPathSecretOfAddedLeaf (t.child li) li pNext leafLi = .success pathSecret) ∧
  (¬ (t.child li).containsLeafIndex leafLi → opn = some pathSecret)
:= by
  rw [getPathSecretOfAddedLeaf.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq] at h
  split at h
  · simp [Result.internalFailure] at h
  · split at h
    · grind
    · split at h <;> simp_all [Result.internalFailure]

theorem getPathSecretOfAddedLeaf_zero (t: TreeKEM Bytes 0) (li: Nat) (p: PathSecrets Bytes 0) (leafLi: Nat)
  (pathSecret: Bytes) (h: getPathSecretOfAddedLeaf t li p leafLi = .success pathSecret):
  False
:= by
  cases p
  rw [getPathSecretOfAddedLeaf.eq_def] at h
  simp [Result.internalFailure] at h

theorem length_multiEncryptWithLabelEntropyLengths (pks: List Bytes):
  (multiEncryptWithLabelEntropyLengths pks).length = pks.length
:= by
  induction pks <;> simp_all [multiEncryptWithLabelEntropyLengths]

theorem getPrivateKey_node {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (optSk: Option Bytes) (pNext: TreeKEMPriv Bytes l)
  (sk: Bytes) (h: getPrivateKey t li (.node optSk pNext) = .success sk):
  (t.nodeContent.isSome ∧ (sk = pNext.getPathLeaf ∨ optSk = some sk)) ∨
  (t.nodeContent = none ∧ getPrivateKey (t.child li) li pNext = .success sk)
:= by
  rw [getPrivateKey.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq] at h
  cases hc: t.nodeContent with
  | none =>
    grind
  | some pn =>
    simp only [hc] at h
    left
    refine ⟨rfl, ?_⟩
    split at h
    · simp_all
    · cases optSk <;> simp_all [Result.error]

theorem getPrivateKey_zero (t: TreeKEM Bytes 0) (li: Nat) (p: TreeKEMPriv Bytes 0) (sk: Bytes)
  (h: getPrivateKey t li p = .success sk):
  p = .leaf sk
:= by
  cases p
  rw [getPrivateKey.eq_def] at h
  simp_all

theorem getPathSecret_node {l: Nat} (t: TreeKEM Bytes (l+1)) (myLi li: Nat) (optSk: Option Bytes)
  (pPrivNext: TreeKEMPriv Bytes l) (optUpn: Option (UpdatePathNode Bytes)) (pUpdNext: PathKEM Bytes l)
  (groupContext: GroupContext Bytes) (pathSecret: Bytes) (level: Nat)
  (h: getPathSecret t myLi li (.node optSk pPrivNext) (.node optUpn pUpdNext) groupContext = .success (pathSecret, level)):
  ((t.child li).containsLeafIndex myLi ∧
    getPathSecret (t.child li) myLi li pPrivNext pUpdNext groupContext = .success (pathSecret, level)) ∨
  (¬ (t.child li).containsLeafIndex myLi ∧ level = l+1 ∧
    ∃ upn myIndex myCiphertext myPrivateKey,
      optUpn = some upn ∧
      resolutionIndex (t.sibling li) myLi = .success myIndex ∧
      upn.encryptedPathSecret.val[myIndex]? = some myCiphertext ∧
      getPrivateKey (t.sibling li) myLi pPrivNext = .success myPrivateKey ∧
      decryptWithLabel myPrivateKey "UpdatePathNode" (serializeNE GroupContext.mf groupContext)
        myCiphertext.kemOutput.val myCiphertext.ciphertext.val = .success pathSecret)
:= by
  rw [getPathSecret.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq] at h
  split at h
  · grind
  · right
    refine ⟨‹_›, ?_⟩
    cases optUpn with
    | none => simp [Result.internalFailure] at h
    | some upn =>
      simp only [Result.bind_eq_success] at h
      obtain ⟨myIndex, h1, h⟩ := h
      cases hct: upn.encryptedPathSecret.val[myIndex]? with
      | none => simp [hct, Result.internalFailure] at h
      | some myCiphertext =>
        simp only [hct, Result.bind_eq_success, Result.pure_eq_success] at h
        obtain ⟨myPrivateKey, h2, kemOutput, h3, pathSecret', h4, rfl, rfl⟩ := h
        have: kemOutput = myCiphertext.kemOutput.val := by
          unfold mkHpkeKemOutput at h3
          split at h3 <;> simp_all [Result.error]
        grind

theorem getPathSecret_zero (t: TreeKEM Bytes 0) (myLi li: Nat) (pPriv: TreeKEMPriv Bytes 0) (pUpd: PathKEM Bytes 0)
  (groupContext: GroupContext Bytes) (pathSecret: Bytes) (level: Nat)
  (h: getPathSecret t myLi li pPriv pUpd groupContext = .success (pathSecret, level)):
  False
:= by
  cases pPriv
  cases pUpd
  rw [getPathSecret.eq_def] at h
  simp [Result.internalFailure] at h

theorem pathApplyPath_node {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (optSk: Option Bytes) (pPrivNext: TreeKEMPriv Bytes l)
  (pathSecret: Bytes) (pathNodeLevel: Nat) (res: TreeKEMPriv Bytes (l+1)) (pathSecretN: Bytes)
  (h: pathApplyPath t li (.node optSk pPrivNext) pathSecret pathNodeLevel = .success (res, pathSecretN)):
  ∃ newPPrivNext pathSecret',
    (if pathNodeLevel = l+1 then newPPrivNext = pPrivNext ∧ pathSecret' = pathSecret
    else pathApplyPath (t.child li) li pPrivNext pathSecret pathNodeLevel = .success (newPPrivNext, pathSecret')) ∧
    (if isTreeEmpty (t.sibling li) then
      res = .node none newPPrivNext ∧ pathSecretN = pathSecret'
    else
      ∃ sk pk,
        deriveKeypairFromPathSecret pathSecret' = .success (sk, pk) ∧
        deriveNextPathSecret pathSecret' = .success pathSecretN ∧
        t.nodeContent.map (·.publicKey) = some pk ∧
        res = .node (some sk) newPPrivNext)
:= by
  rw [pathApplyPath.eq_def] at h
  simp only [Tree.intoChildSiblingView_eq] at h
  obtain ⟨⟨newPPrivNext, pathSecret'⟩, h1, h2⟩: ∃ x: TreeKEMPriv Bytes l × Bytes,
      (if pathNodeLevel = l+1 then pure (pPrivNext, pathSecret)
        else pathApplyPath (t.child li) li pPrivNext pathSecret pathNodeLevel) = .success x ∧
      (if !isTreeEmpty (t.sibling li) then do
        let (sk, pk) ← deriveKeypairFromPathSecret x.2
        let newPathSecret ← deriveNextPathSecret x.2
        if !(t.nodeContent.map (fun (pn: TreeKEMNode Bytes) => pn.publicKey) == some pk) then
          Result.error "path_apply_path: wrong public key"
        else
          pure ((Path.node (some sk) x.1: TreeKEMPriv Bytes (l+1)), newPathSecret)
      else
        pure ((Path.node none x.1: TreeKEMPriv Bytes (l+1)), x.2)) = .success (res, pathSecretN)
  := by
    by_cases hlvl: pathNodeLevel = l + 1 <;> simp only [hlvl, ite_false] at h ⊢ <;>
      exact Result.bind_eq_success _ _ _ |>.mp h
  refine ⟨newPPrivNext, pathSecret', ?_, ?_⟩
  · split at h1 <;> simp_all
  · split at h2
    · rename_i hsib
      simp only [Bool.not_eq_true'] at hsib
      simp only [hsib, Bool.false_eq_true]
      simp only [Result.bind_eq_success] at h2
      obtain ⟨⟨sk, pk⟩, h3, newPathSecret, h4, h5⟩ := h2
      split at h5
      · simp [Result.error] at h5
      · rename_i hpk
        simp only [Result.pure_eq_success] at h5
        obtain ⟨rfl, rfl⟩ := h5
        refine ⟨sk, pk, h3, h4, ?_, rfl⟩
        simpa using hpk
    · rename_i hsib
      simp only [Bool.not_eq_true', Bool.not_eq_false] at hsib
      simp only [hsib]
      simp only [Result.pure_eq_success, Prod.mk.injEq] at h2
      grind

theorem pathApplyPath_zero (t: TreeKEM Bytes 0) (li: Nat) (pPriv: TreeKEMPriv Bytes 0) (pathSecret: Bytes)
  (pathNodeLevel: Nat) (res: TreeKEMPriv Bytes 0) (pathSecretN: Bytes)
  (h: pathApplyPath t li pPriv pathSecret pathNodeLevel = .success (res, pathSecretN)):
  False
:= by
  cases pPriv
  rw [pathApplyPath.eq_def] at h
  simp [Result.internalFailure] at h

/-- Two path secrets deriving the same public key are equal (on symbolic bytes). -/
theorem deriveKeypairFromPathSecret_inj (pathSecret1 pathSecret2 sk1 sk2 pk: Bytes)
  (h1: deriveKeypairFromPathSecret pathSecret1 = .success (sk1, pk))
  (h2: deriveKeypairFromPathSecret pathSecret2 = .success (sk2, pk)):
  pathSecret1 = pathSecret2
:= by
  obtain ⟨he1, rfl⟩ := deriveKeypairFromPathSecret_eq_success _ _ _ h1
  obtain ⟨he2, hpk⟩ := deriveKeypairFromPathSecret_eq_success _ _ _ h2
  obtain ⟨_, -, -, -, rfl⟩ := expandWithLabel_eq_success _ _ _ _ _ he1
  obtain ⟨_, -, -, -, rfl⟩ := expandWithLabel_eq_success _ _ _ _ _ he2
  simp only [hpkePk, DySlop.Kem.kemPk, DySlop.KdfExpand.kdfExpand] at hpk
  grind

end Code

/-! ## Path secrets -/

/-- Port of `generate_path_secrets_correct_join_lemma`. -/
theorem equivalent_join_of_equivalent [BytesFunctor] [ExecTraceTypes] (l1 l1' l2 l3: Label) (tr: ExecTrace)
  (h1: l1.equivalent l1' tr) (h3: l3.equivalent (l1.join l2) tr):
  l3.equivalent (l1'.join l2) tr
:=
  Label.equivalent_trans _ _ _ _ h3 (Label.equivalent_join _ _ _ _ _ h1 (Label.equivalent_refl _ _))


section Correct

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

omit [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace] in
/-- The public key of an HPKE private key satisfying the invariant is publishable. -/
theorem hpkePk_publishable (sk: Bytes) (tr: ProofTrace) (h: sk.Invariant tr): (hpkePk sk).Publishable tr :=
  ⟨by rwa [hpkePk.Invariant], by rw [hpkePk.label]; exact canFlowRefl _ _⟩

theorem expandUsagePathSecretPath_toUsage (x: PathSecretUsage) (prkLabel: Label) (context: Bytes) (len: Nat):
  expandUsagePathSecretPath.getUsage "path" x.toUsage context len = PathSecretUsage.toUsage x.tail ∧
  expandUsagePathSecretPath.getLabel "path" x.toUsage prkLabel context len = prkLabel.join x.headLabel
:= by
  simp only [expandUsagePathSecretPath, ExpandWithLabelUsage.Local.getUsage_single,
    ExpandWithLabelUsage.Local.getLabel_single, PathSecretUsage.ofUsage_toUsage]
  cases x <;> simp [PathSecretUsage.headLabel, Label.join_secret_right]

theorem expandUsagePathSecretPath_kdfExpandKey (data: Bytes) (prkLabel: Label) (context: Bytes) (len: Nat) (tr: ExecTrace):
  (∃ data', expandUsagePathSecretPath.getUsage "path" (Usage.kdfExpandKey "MLS.PathSecret" data) context len =
    Usage.kdfExpandKey "MLS.PathSecret" data') ∧
  (expandUsagePathSecretPath.getLabel "path" (Usage.kdfExpandKey "MLS.PathSecret" data) prkLabel context len).canFlow prkLabel tr
:= by
  simp only [expandUsagePathSecretPath, ExpandWithLabelUsage.Local.getUsage_single, ExpandWithLabelUsage.Local.getLabel_single]
  refine ⟨?_, ?_⟩
  · split <;> exact ⟨_, rfl⟩
  · grind

omit [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace] in
theorem expandUsagePathSecretNode_eq (prkUsage: Usage) (prkLabel: Label) (context: Bytes) (len: Nat):
  expandUsagePathSecretNode.getUsage "node" prkUsage context len = nodeKeyUsage ∧
  expandUsagePathSecretNode.getLabel "node" prkUsage prkLabel context len = prkLabel
:= by
  simp [expandUsagePathSecretNode, ExpandWithLabelUsage.Local.getUsage_single,
    ExpandWithLabelUsage.Local.getLabel_single, ExpandWithLabelUsage.secret]

/-- Port of `leaf_sk_is_correct`. -/
@[expose]
public
def LeafSkIsCorrect (leafSk: Bytes) (me: Participant) (_groupId: MlsBytes Bytes) (tr: ProofTrace): Prop :=
  leafSk.Invariant tr ∧
  (leafSk.label tr).equivalent (nodeKeyLabel me (hpkePk leafSk)) tr.erase ∧
  leafSk.HasUsage nodeKeyUsage tr

/-- Port of `leaf_pk_is_correct`. -/
@[expose]
public
def LeafPkIsCorrect (leafPk: Bytes) (me: Participant) (_groupId: MlsBytes Bytes) (tr: ProofTrace): Prop :=
  leafPk.Publishable tr ∧
  (leafPk.hpkeSkLabel tr).equivalent (nodeKeyLabel me leafPk) tr.erase ∧
  leafPk.HpkeSkHasUsage nodeKeyUsage tr

/-- Port of `path_secret_is_correct`. -/
@[expose]
public
def PathSecretIsCorrect (committer: Participant) (committerLeafPk: Bytes) (isAtRoot: Bool)
  (pathSecret: Bytes) {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace): Prop
:=
  pathSecret.Invariant tr ∧
  (pathSecret.label tr).equivalent ((nodeKeyLabel committer committerLeafPk).join (nodeSkLabelNocommitter t groupId li)) tr.erase ∧
  (∃ data, pathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr) ∧
  (isAtRoot → pathSecret.HasUsage (PathSecretUsage.toUsage []) tr)

/--
Port of `path_secrets_are_correct`.
The leaf index of the path (implicit in MLS*) is `li`.
-/
@[expose]
public
def PathSecretsAreCorrect (me: Participant): (isAtRoot: Bool) → {l: Nat} → TreeSync Bytes tkt l → (li: Nat) →
  MlsBytes Bytes → PathSecrets Bytes l → ProofTrace → Prop
  | _, _, _, _, groupId, .leaf leafSk, tr => LeafSkIsCorrect leafSk me groupId tr
  | isAtRoot, _, t, li, groupId, .node none pNext, tr =>
    isTreeEmpty (t.sibling li) ∧ PathSecretsAreCorrect me isAtRoot (t.child li) li groupId pNext tr
  | isAtRoot, _, t, li, groupId, .node (some ps) pNext, tr =>
    PathSecretIsCorrect me (hpkePk pNext.getPathLeaf) isAtRoot ps t groupId li tr ∧
    PathSecretsAreCorrect me false (t.child li) li groupId pNext tr

/-- Port of `path_secrets_are_correct_later`. -/
public
theorem PathSecretsAreCorrect_later {l: Nat} (me: Participant) (isAtRoot: Bool) (t: TreeSync Bytes tkt l) (li: Nat)
  (groupId: MlsBytes Bytes) (p: PathSecrets Bytes l) (tr1 tr2: ProofTrace)
  : tr1 ≤ tr2 →
    PathSecretsAreCorrect me isAtRoot t li groupId p tr1 →
    PathSecretsAreCorrect me isAtRoot t li groupId p tr2
:= by
  intro hle
  induction p generalizing isAtRoot with
  | leaf => grind [PathSecretsAreCorrect, LeafSkIsCorrect]
  | node opn pNext ih =>
    cases opn <;> simp only [PathSecretsAreCorrect, PathSecretIsCorrect] <;> grind

grind_pattern PathSecretsAreCorrect_later => tr1 ≤ tr2, PathSecretsAreCorrect me isAtRoot t li groupId p tr1
grind_pattern [grind_later] PathSecretsAreCorrect_later => tr1 ≤ tr2, PathSecretsAreCorrect me isAtRoot t li groupId p tr1

theorem nodeSkLabelNocommitter_zero (t: TreeSync Bytes tkt 0) (groupId: MlsBytes Bytes) (li: Nat)
  (hli: t.containsLeafIndex li):
  nodeSkLabelNocommitter t groupId li = Label.secret
:= by
  have := eq_of_containsLeafIndex_zero t.containsLeafIndex_position hli
  subst this
  rw [nodeSkLabelNocommitter, nodeSkLabelAux_zero]
  cases t.leafContent <;> simp [nodeSkLabelAuxLeaf_noCommitter_self]

variable [HasMlsTreekemInvariants]

/--
`expand_with_label_lemma` for the derivation of a node key from a path secret (`expand_usage_path_secret_node`):
the node private key has the label of the path secret, and the usage of node keys.
-/
theorem deriveKeypairFromPathSecret_invariant (tr: ProofTrace) (pathSecret sk pk data: Bytes)
  (h: deriveKeypairFromPathSecret pathSecret = .success (sk, pk))
  (hinv: pathSecret.Invariant tr) (husg: pathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr):
  pk = hpkePk sk ∧ sk.Invariant tr ∧ sk.HasUsage nodeKeyUsage tr ∧ (sk.label tr).equivalent (pathSecret.label tr) tr.erase
:= by
  obtain ⟨hexp, rfl⟩ := deriveKeypairFromPathSecret_eq_success pathSecret sk pk h
  have := expandWithLabel.Invariant expandUsagePathSecretNode "MLS.PathSecret" tr pathSecret _ "node" _ _ sk hexp hinv
    (BytesCompatiblePred.pred_empty (pred := (Bytes.Invariant · tr))) husg rfl rfl (by simp)
  rw [(expandUsagePathSecretNode_eq _ (pathSecret.label tr) _ _).1, (expandUsagePathSecretNode_eq _ (pathSecret.label tr) _ _).2] at this
  exact ⟨rfl, this⟩

/--
`expand_with_label_lemma` for the derivation of the next path secret (`expand_usage_path_secret_path`):
the next path secret has the remaining usages, and its label is joined with the label of the first usage.
-/
theorem deriveNextPathSecret_invariant (tr: ProofTrace) (pathSecret nextPathSecret: Bytes) (x: PathSecretUsage)
  (h: deriveNextPathSecret pathSecret = .success nextPathSecret)
  (hinv: pathSecret.Invariant tr) (husg: pathSecret.HasUsage x.toUsage tr):
  nextPathSecret.Invariant tr ∧ nextPathSecret.HasUsage (PathSecretUsage.toUsage x.tail) tr ∧
  (nextPathSecret.label tr).equivalent ((pathSecret.label tr).join x.headLabel) tr.erase
:= by
  rw [deriveNextPathSecret_eq] at h
  have := expandWithLabel.Invariant expandUsagePathSecretPath "MLS.PathSecret" tr pathSecret _ "path" _ _ nextPathSecret h hinv
    (BytesCompatiblePred.pred_empty (pred := (Bytes.Invariant · tr))) husg rfl rfl (by simp)
  rwa [(expandUsagePathSecretPath_toUsage x (pathSecret.label tr) _ _).1,
    (expandUsagePathSecretPath_toUsage x (pathSecret.label tr) _ _).2] at this

/-- `deriveNextPathSecret_invariant`, when the usages of the path secret are unknown. -/
theorem deriveNextPathSecret_invariant_weak (tr: ProofTrace) (pathSecret nextPathSecret data: Bytes)
  (h: deriveNextPathSecret pathSecret = .success nextPathSecret)
  (hinv: pathSecret.Invariant tr) (husg: pathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr):
  nextPathSecret.Invariant tr ∧ (∃ data', nextPathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data') tr) ∧
  (nextPathSecret.label tr).canFlow (pathSecret.label tr) tr.erase
:= by
  rw [deriveNextPathSecret_eq] at h
  obtain ⟨hN, hNUsg, hNLabel⟩ := expandWithLabel.Invariant expandUsagePathSecretPath "MLS.PathSecret" tr pathSecret _ "path"
    _ _ nextPathSecret h hinv (BytesCompatiblePred.pred_empty (pred := (Bytes.Invariant · tr))) husg rfl rfl (by simp)
  obtain ⟨⟨data', hdata'⟩, hlabel⟩ := expandUsagePathSecretPath_kdfExpandKey data (pathSecret.label tr) BytesLike.empty 32 tr.erase
  exact ⟨hN, ⟨data', hdata' ▸ hNUsg⟩, canFlowTrans _ _ _ _ hNLabel.1 hlabel⟩

/--
Port of `generate_path_secrets_proof`.
MLS*'s preconditions on `leaf_sk` are `LeafSkIsCorrect`, and MLS* requires `li: leaf_index l i` (here `hli`).
-/
public
theorem generatePathSecrets_proof (me: Participant) {l: Nat} (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l)
  (leafSk pathSecret0: Bytes) (li: Nat) (groupId: MlsBytes Bytes) (tr: ProofTrace) (acc: PathSecretUsage)
  (p: PathSecrets Bytes l) (pathSecretN: Bytes)
  (h: generatePathSecrets tk leafSk pathSecret0 li = .success (p, pathSecretN))
  (hrel: treesyncTreekemRel ts tk) (hli: ts.containsLeafIndex li)
  (hleafSk: LeafSkIsCorrect leafSk me groupId tr)
  (hps0: pathSecret0.Invariant tr)
  (hps0Label: (pathSecret0.label tr).equivalent
    ((nodeKeyLabel me (hpkePk leafSk)).join (computePathSecretUsage ts groupId li acc).headLabel) tr.erase)
  (hps0Usage: pathSecret0.HasUsage (PathSecretUsage.toUsage (computePathSecretUsage ts groupId li acc).tail) tr):
  PathSecretsAreCorrect me acc.isEmpty ts li groupId p tr ∧
  pathSecretN.Invariant tr ∧
  pathSecretN.HasUsage (PathSecretUsage.toUsage acc.tail) tr ∧
  (pathSecretN.label tr).equivalent
    ((nodeKeyLabel me (hpkePk leafSk)).join ((nodeSkLabelNocommitter ts groupId li).join acc.headLabel)) tr.erase ∧
  p.getPathLeaf = leafSk
:= by
  subst hrel
  induction ts using Tree.childInduction li generalizing acc pathSecretN with
  | leaf ts =>
    obtain ⟨rfl, rfl⟩ := generatePathSecrets_zero _ leafSk pathSecret0 li p pathSecretN h
    rw [computePathSecretUsage_zero] at hps0Label hps0Usage
    rw [nodeSkLabelNocommitter_zero ts groupId li hli, Label.join_secret_left]
    exact ⟨hleafSk, hps0, hps0Usage, hps0Label, rfl⟩
  | node ts ih =>
    obtain ⟨pNext, myPathSecret, h1, h2⟩ := generatePathSecrets_node _ leafSk pathSecret0 li p pathSecretN h
    rw [child_treesyncToTreekem] at h1
    rw [sibling_treesyncToTreekem, isTreeEmpty_treesyncToTreekem] at h2
    rw [computePathSecretUsage_succ] at hps0Label hps0Usage
    have hli' := Tree.mem_child_self ts hli
    have hsucc := nodeSkLabelNocommitter_succ ts groupId li
    cases hsib: isTreeEmpty (ts.sibling li)
    · -- the sibling is not empty: the node has a path secret, whose first usage is the one of the sibling
      simp only [hsib, Bool.not_false, Bool.false_eq_true, ite_false] at hps0Label hps0Usage h2
      obtain ⟨rfl, hnext⟩ := h2
      obtain ⟨hp, hmy, hmyUsage, hmyLabel, hleaf⟩ :=
        ih (h := h1) (hli := hli') (hps0Label := hps0Label) (hps0Usage := hps0Usage)
      -- the label of the path secret of the node joins the labels of the child and of the sibling
      have hmyLabel': (myPathSecret.label tr).equivalent
          ((nodeKeyLabel me (hpkePk leafSk)).join (nodeSkLabelNocommitter ts groupId li)) tr.erase
      := by
        rw [← hsucc]
        simpa [PathSecretUsage.headLabel, onePathSecretUsageToPathSecretLabel] using hmyLabel
      have hmyCorrect: PathSecretIsCorrect me (hpkePk pNext.getPathLeaf) acc.isEmpty myPathSecret ts groupId li tr := by
        refine ⟨hmy, hleaf ▸ hmyLabel', ⟨_, hmyUsage⟩, fun hroot => ?_⟩
        rwa [List.isEmpty_iff.mp hroot] at hmyUsage
      -- the next path secret is derived from it, and has the next usage
      obtain ⟨hN, hNUsage, hNLabel⟩ := deriveNextPathSecret_invariant tr myPathSecret pathSecretN acc hnext hmy hmyUsage
      refine ⟨⟨hmyCorrect, by simpa using hp⟩, hN, hNUsage, ?_, hleaf⟩
      rw [← Label.join_assoc]
      exact equivalent_join_of_equivalent _ _ _ _ _ hmyLabel' hNLabel
    · -- the sibling is empty: the node is filtered, and its label is the one of the child
      simp only [hsib, Bool.not_true, Bool.false_eq_true, ite_false] at hps0Label hps0Usage h2
      obtain ⟨rfl, rfl⟩ := h2
      obtain ⟨hp, hmy, hmyUsage, hmyLabel, hleaf⟩ :=
        ih (h := h1) (hli := hli') (hps0Label := hps0Label) (hps0Usage := hps0Usage)
      rw [← hsucc, nodeSkLabelNosig, nodeSkLabelAux_of_isTreeEmpty _ _ _ hsib, Label.join_secret_right]
      exact ⟨⟨hsib, hp⟩, hmy, hmyUsage, hmyLabel, hleaf⟩

end Correct

/-! ## Node keys -/

section NodeKeys

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/-- Port of `node_sk_is_correct`. -/
@[expose]
public
def NodeSkIsCorrect (committer: Participant) (committerLeafPk: Bytes) (nodeSk: Bytes)
  {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace): Prop
:=
  nodeSk.Invariant tr ∧
  ((nodeKeyLabel committer committerLeafPk).join (nodeSkLabelNocommitter t groupId li)).equivalent (nodeSk.label tr) tr.erase ∧
  nodeSk.HasUsage nodeKeyUsage tr

/-- The node private keys generated by a committer are node private keys of the committer's leaf. -/
theorem NodeSkIsCorrect.isNodeSkForLeafPk (committer: Participant) (committerLeafPk: Bytes) (nodeSk: Bytes)
  {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace)
  (h: NodeSkIsCorrect committer committerLeafPk nodeSk t groupId li tr):
  IsNodeSkForLeafPk tr committer committerLeafPk nodeSk
:=
  ⟨h.1, canFlowTrans _ _ _ _ h.2.1.2 (Label.joinCanFlowLeft _ _ _), h.2.2⟩

/-- Port of `node_pk_is_correct`. -/
@[expose]
public
def NodePkIsCorrect (committer: Participant) (committerLeafPk: Bytes) (isAtRoot: Bool) (nodePk: Bytes)
  {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace): Prop
:=
  nodePk.Publishable tr ∧
  ((nodeKeyLabel committer committerLeafPk).join (nodeSkLabelNocommitter t groupId li)).canFlow (nodePk.hpkeSkLabel tr) tr.erase ∧
  nodePk.HpkeSkHasUsage nodeKeyUsage tr ∧
  (isAtRoot → IsRootNodePk tr nodePk)

/--
Port of `pre_pathkem_correct`.
The leaf index of the path (implicit in MLS*) is `li`.
-/
@[expose]
public
def PrePathkemCorrect (committer: Participant): (isAtRoot: Bool) → {l: Nat} → TreeSync Bytes tkt l → (li: Nat) →
  PrePathKEM Bytes l → MlsBytes Bytes → ProofTrace → Prop
  | _, _, _, _, .leaf { publicKey }, groupId, tr => LeafPkIsCorrect publicKey committer groupId tr
  | isAtRoot, _, t, li, .node none pNext, groupId, tr =>
    isTreeEmpty (t.sibling li) ∧ PrePathkemCorrect committer isAtRoot (t.child li) li pNext groupId tr
  | isAtRoot, _, t, li, .node (some nodePk) pNext, groupId, tr =>
    NodePkIsCorrect committer pNext.getPathLeaf.publicKey isAtRoot nodePk.val t groupId li tr ∧
    PrePathkemCorrect committer false (t.child li) li pNext groupId tr

variable [HasMlsTreekemInvariants]

/-- Port of `derive_keypair_from_path_secret_proof`. -/
public
theorem deriveKeypairFromPathSecret_proof (committer: Participant) (committerLeafPk: Bytes) (isAtRoot: Bool)
  (pathSecret: Bytes) {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace)
  (sk pk: Bytes)
  (h: deriveKeypairFromPathSecret pathSecret = .success (sk, pk))
  (hps: PathSecretIsCorrect committer committerLeafPk isAtRoot pathSecret t groupId li tr):
  NodeSkIsCorrect committer committerLeafPk sk t groupId li tr ∧
  NodePkIsCorrect committer committerLeafPk isAtRoot pk t groupId li tr
:= by
  obtain ⟨hinv, hlabel, ⟨data, husg⟩, hroot⟩ := hps
  obtain ⟨rfl, hsk, hskUsg, hskLabel⟩ := deriveKeypairFromPathSecret_invariant tr pathSecret sk pk data h hinv husg
  have hlabel' := Label.equivalent_trans _ _ _ _ (Label.equivalent_symm _ _ _ hlabel) (Label.equivalent_symm _ _ _ hskLabel)
  refine ⟨⟨hsk, hlabel', hskUsg⟩, hpkePk_publishable sk tr hsk, ?_, by rwa [HpkeSkHasUsage_hpkePk], ?_⟩
  · rw [hpkeSkLabel_hpkePk]
    exact hlabel'.1
  · exact fun hr => ⟨pathSecret, sk, h, hinv, hroot hr⟩

/--
Port of `path_secrets_to_pre_pathkem_proof`.
The leaf index of the path (implicit in MLS*) is `li`.
-/
public
theorem pathSecretsToPrePathkem_proof (me: Participant) (isAtRoot: Bool) {l: Nat} (t: TreeSync Bytes tkt l) (li: Nat)
  (p: PathSecrets Bytes l) (groupId: MlsBytes Bytes) (tr: ProofTrace) (res: PrePathKEM Bytes l)
  (h: pathSecretsToPrePathkem p = .success res)
  (hp: PathSecretsAreCorrect me isAtRoot t li groupId p tr):
  PrePathkemCorrect me isAtRoot t li res groupId tr ∧
  res.getPathLeaf.publicKey = hpkePk p.getPathLeaf
:= by
  induction p generalizing isAtRoot with
  | leaf leafSk =>
    obtain ⟨sk, hgen⟩ := pathSecretsToPrePathkem_getPathLeaf _ res h
    obtain ⟨rfl, hpk⟩ := hpkeGenKeypair_eq_success _ _ _ hgen
    cases res with | leaf lp =>
    obtain ⟨publicKey⟩ := lp
    obtain ⟨hinv, hlabel, husg⟩ := hp
    simp only [Path.getPathLeaf] at hpk ⊢
    subst hpk
    refine ⟨⟨hpkePk_publishable _ tr hinv, ?_, by rwa [HpkeSkHasUsage_hpkePk]⟩, rfl⟩
    rwa [hpkeSkLabel_hpkePk]
  | node opn pNext ih =>
    obtain ⟨oppk, ppkNext, rfl, h1, hsome, hpk⟩ := pathSecretsToPrePathkem_node opn pNext res h
    cases opn with
    | none =>
      obtain rfl: oppk = none := by simpa using hsome
      obtain ⟨hsib, hp⟩ := hp
      obtain ⟨ih1, ih2⟩ := ih (t := t.child li) (isAtRoot := isAtRoot) (res := ppkNext) h1 hp
      exact ⟨⟨hsib, ih1⟩, ih2⟩
    | some ps =>
      obtain ⟨nodePk, rfl, sk, hderive⟩ := hpk ps rfl
      obtain ⟨hps, hp⟩ := hp
      obtain ⟨ih1, ih2⟩ := ih (t := t.child li) (isAtRoot := false) (res := ppkNext) h1 hp
      refine ⟨⟨?_, ih1⟩, ih2⟩
      rw [ih2]
      exact (deriveKeypairFromPathSecret_proof me _ isAtRoot ps t groupId li tr sk nodePk.val hderive hps).2

end NodeKeys

/-! ## Multi-encryption -/

section MultiEncrypt

variable [HasSymbolicInvariants]

/--
Port of `multi_encrypt_with_label_pre_weak`.
MLS*'s local EncryptWithLabel predicate `lpred` (of the label of the encryption) is `l.pred label`.
-/
@[expose]
public
def MultiEncryptWithLabelPreWeak {labels: List String} (l: EncryptWithLabelPred.Local labels) (label: String)
  (pks: List Bytes) (context plaintext: Bytes) (rand: Randomness Bytes) (tr: ProofTrace): Prop
:=
  match pks, rand.rand with
  | pk :: pks, r :: randNext =>
    MultiEncryptWithLabelPreWeak l label pks context plaintext { rand := randNext } tr ∧
    pk.Invariant tr ∧
    r.Invariant tr ∧
    context.Invariant tr ∧
    plaintext.Invariant tr ∧
    (plaintext.label tr).canFlow (r.label tr) tr.erase ∧
    (r.label tr).canFlow (pk.hpkeSkLabel tr) tr.erase ∧
    r.HasUsage entropyUsageForNodeKey tr ∧ (
      (
        pk.HpkeSkHasUsage nodeKeyUsage tr ∧
        l.pred label BytesLike.empty plaintext context tr
      ) ∨ (
        (r.label tr).canFlow Label.pub tr.erase
      )
    )
  | _, _ => True

/-- Port of `hpke_ciphertext_is_publishable`. -/
@[expose]
public
def HpkeCiphertextIsPublishable (tr: ProofTrace) (c: HpkeCiphertext Bytes): Prop :=
  HpkeCiphertext.mf.wf (Bytes.Publishable · tr) c

/-- Port of `multi_encrypt_with_label_proof`. -/
public
theorem multiEncryptWithLabel_proof {labels: List String} (l: EncryptWithLabelPred.Local labels)
  [EncryptWithLabelPred.Has "MLS.NodeHpkeKey" l]
  [KdfExpand.KdfExpandUsage.Has HPKE.kdfExpandUsage] [Aead.AeadPred.Has HPKE.aeadPred]
  (pks: List Bytes) (label: String) (context plaintext: Bytes) (rand: Randomness Bytes) (tr: ProofTrace)
  (res: List (HpkeCiphertext Bytes))
  (h: multiEncryptWithLabel pks label context plaintext rand = .success res)
  (hpre: MultiEncryptWithLabelPreWeak l label pks context plaintext rand tr) (hlabel: label ∈ labels):
  ∀ c ∈ res, HpkeCiphertextIsPublishable tr c
:= by
  induction pks generalizing rand res with
  | nil =>
    simp only [multiEncryptWithLabel, Result.pure_eq_success] at h
    simp [← h]
  | cons pk pks ih =>
    obtain ⟨randCur, randNext, kemOutput, ciphertext, c, resTl, hrand, henc, hrec, rfl, hkem, hct⟩ :=
      multiEncryptWithLabel_cons pk pks label context plaintext rand res h
    rw [MultiEncryptWithLabelPreWeak.eq_def, hrand] at hpre
    obtain ⟨hnext, hpk, hr, hctx, hpt, hflow1, hflow2, husg, hhonest⟩ := hpre
    have := encryptWithLabel.Invariant l "MLS.NodeHpkeKey" BytesLike.empty tr pk label context plaintext randCur
      kemOutput ciphertext henc hpk hr hctx hpt hflow1 hflow2 husg hhonest hlabel
    intro x hx
    rcases List.mem_cons.mp hx with rfl | hx
    · simp [HpkeCiphertextIsPublishable, hkem, hct, this]
    · exact ih randNext resTl hrec hnext x hx

/-- Port of `multi_encrypt_with_label_entropy_ghost_data`. -/
@[expose]
public
def multiEncryptWithLabelEntropyGhostData (pks: List Bytes) (randLabel: Label): RandomnessGhostData :=
  pks.map fun _ => (entropyUsageForNodeKey, randLabel)

/-- Port of `multi_encrypt_with_label_pre_strong_one`. -/
@[expose]
public
def MultiEncryptWithLabelPreStrongOne (tr: ProofTrace) (randLabel: Label) (pk: Bytes): Prop :=
  pk.Invariant tr ∧
  randLabel.canFlow (pk.hpkeSkLabel tr) tr.erase ∧ (
    (
      pk.HpkeSkHasUsage nodeKeyUsage tr
    ) ∨ (
      randLabel.canFlow Label.pub tr.erase
    )
  )

/-- Port of `multi_encrypt_with_label_pre_strong`. -/
@[expose]
public
def MultiEncryptWithLabelPreStrong (pks: List Bytes) (context plaintext: Bytes) (rand: Randomness Bytes)
  (randLabel: Label) (tr: ProofTrace): Prop
:=
  (∀ pk ∈ pks, MultiEncryptWithLabelPreStrongOne tr randLabel pk) ∧
  RandomnessHasGhostData tr rand (multiEncryptWithLabelEntropyGhostData pks randLabel) ∧
  context.Invariant tr ∧
  plaintext.Invariant tr ∧
  (plaintext.label tr).canFlow randLabel tr.erase ∧
  mlsHpkeUpdatepathnodePred.pred "UpdatePathNode" BytesLike.empty plaintext context tr

/-- Port of `multi_encrypt_with_label_pre_strong_implies_weak`. -/
theorem multiEncryptWithLabelPreStrong_weak (pks: List Bytes) (context plaintext: Bytes) (rand: Randomness Bytes)
  (randLabel: Label) (tr: ProofTrace)
  (h: MultiEncryptWithLabelPreStrong pks context plaintext rand randLabel tr):
  MultiEncryptWithLabelPreWeak mlsHpkeUpdatepathnodePred "UpdatePathNode" pks context plaintext rand tr
:= by
  induction pks generalizing rand with
  | nil => simp [MultiEncryptWithLabelPreWeak]
  | cons pk pks ih =>
    obtain ⟨hpks, hrand, hctx, hpt, hflow, hpred⟩ := h
    obtain ⟨_ | ⟨r, randNext⟩⟩ := rand
    · simp [multiEncryptWithLabelEntropyGhostData, RandomnessHasGhostData, RandomnessHasGhostData.go] at hrand
    simp only [multiEncryptWithLabelEntropyGhostData, List.map_cons, RandomnessHasGhostData,
      RandomnessHasGhostData.go] at hrand
    obtain ⟨hr, hrUsg, hrLabel, hrand⟩ := hrand
    obtain ⟨hpk, hpkFlow, hhonest⟩ := hpks pk List.mem_cons_self
    subst hrLabel
    simp only [MultiEncryptWithLabelPreWeak]
    refine ⟨ih { rand := randNext } ⟨fun pk hpk => hpks pk (List.mem_cons_of_mem _ hpk), hrand, hctx, hpt, hflow, hpred⟩,
      hpk, hr, hctx, hpt, hflow, hpkFlow, hrUsg, ?_⟩
    grind

/-- Port of `multi_encrypt_with_label_weak_proof`. -/
public
theorem multiEncryptWithLabel_weak_proof [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace] [HasMlsTreekemInvariants]
  (pks: List Bytes) (context plaintext: Bytes) (rand: Randomness Bytes) (randLabel: Label) (tr: ProofTrace)
  (res: List (HpkeCiphertext Bytes))
  (h: multiEncryptWithLabel pks "UpdatePathNode" context plaintext rand = .success res)
  (hpre: MultiEncryptWithLabelPreStrong pks context plaintext rand randLabel tr):
  ∀ c ∈ res, HpkeCiphertextIsPublishable tr c
:=
  multiEncryptWithLabel_proof mlsHpkeUpdatepathnodePred pks "UpdatePathNode" context plaintext rand tr res h
    (multiEncryptWithLabelPreStrong_weak pks context plaintext rand randLabel tr hpre) (by simp)

end MultiEncrypt

/-! ## Resolutions -/

section Resolution

variable {Bytes: Type}

theorem unAddP_zero (t: TreeKEM Bytes 0) (pred: Nat → Bool):
  unAddP t pred = (LeftRightView.leaf (if pred t.position then t.leafContent else none) t.position).pack
:= by
  grind [unAddP]

theorem unAddP_left_right {l: Nat} (t: TreeKEM Bytes (l+1)) (pred: Nat → Bool):
  (unAddP t pred).left = unAddP t.left pred ∧
  (unAddP t pred).right = unAddP t.right pred ∧
  (unAddP t pred).nodeContent = t.nodeContent.map fun kp => { kp with unmergedLeaves := kp.unmergedLeaves.filter pred }
:= by
  have e := unAddP.eq_def t pred
  simp only [Tree.intoLeftRightView_eq] at e
  rw [e]
  have: (unAddP t.right pred).position = (unAddP t.left pred).position + 2^l := by
    simp [Tree.right_position, Tree.left_position]
  simp [LeftRightView.right_pack _ _ _ this]

/-- `unAddP` of a node, through the child / sibling view for any leaf index `li`. -/
theorem unAddP_succ {l: Nat} (t: TreeKEM Bytes (l+1)) (li: Nat) (pred: Nat → Bool):
  (unAddP t pred).child li = unAddP (t.child li) pred ∧
  (unAddP t pred).sibling li = unAddP (t.sibling li) pred ∧
  (unAddP t pred).nodeContent = t.nodeContent.map fun kp => { kp with unmergedLeaves := kp.unmergedLeaves.filter pred }
:= by
  have := unAddP_left_right t pred
  rw [Tree.child_eq_left_right, Tree.child_eq_left_right, Tree.sibling_eq_left_right, Tree.sibling_eq_left_right]
  have: (unAddP t pred).right.position = t.right.position := by rw [this.2.1]; simp
  grind

/-- Port of `leaf_at_un_addP`. MLS* requires `unmerged_leaf_exists t li` (here `hli`, and `pre li`, here the `if`). -/
theorem leafAt_unAddP {l: Nat} (t: TreeKEM Bytes l) (pred: Nat → Bool) (li: Nat) (hli: t.containsLeafIndex li):
  leafAt (unAddP t pred) li = if pred li then leafAt t li else none
:= by
  induction t using Tree.childInduction li with
  | leaf t =>
    have := eq_of_containsLeafIndex_zero t.containsLeafIndex_position hli
    rw [unAddP_zero]
    grind [leafAt.eq_def]
  | node t ih =>
    have := unAddP_succ t li pred
    grind [leafAt.eq_def]

theorem mem_unmergedLeavesResolution {l: Nat} (t: TreeKEM Bytes l) (ul: List Nat) (pk: Bytes):
  pk ∈ unmergedLeavesResolution t ul ↔
    ∃ x ∈ ul, t.containsLeafIndex x ∧ ∃ lp, leafAt t x = some lp ∧ pk = lp.publicKey
:= by
  induction ul with
  | nil => simp [unmergedLeavesResolution]
  | cons x ul ih =>
    simp only [unmergedLeavesResolution]
    grind

theorem mem_treeResolution_zero (t: TreeKEM Bytes 0) (pk: Bytes):
  pk ∈ treeResolution t ↔ ∃ lp, t.leafContent = some lp ∧ pk = lp.publicKey
:= by
  obtain ⟨_, ⟨c⟩⟩ := t
  rw [treeResolution.eq_def]
  cases c <;> simp [Tree.leafContent]

theorem mem_treeResolution_succ {l: Nat} (t: TreeKEM Bytes (l+1)) (pk: Bytes):
  pk ∈ treeResolution t ↔
    (∃ kp, t.nodeContent = some kp ∧ (pk = kp.publicKey ∨ pk ∈ unmergedLeavesResolution t kp.unmergedLeaves)) ∨
    (t.nodeContent = none ∧ (pk ∈ treeResolution t.left ∨ pk ∈ treeResolution t.right))
:= by
  obtain ⟨_, bt⟩ := t
  cases bt with | node c L R =>
  rw [treeResolution.eq_def]
  cases c <;> simp [Tree.intoLeftRightView, Tree.nodeContent, Tree.left, Tree.right]

/-- Port of `for_allP_unmerged_leaves_resolution_un_addP`. MLS* requires `treekem_invariant t` and `treekem_invariant (un_addP t pre)`, which are not needed. -/
theorem mem_unmergedLeavesResolution_unAddP {l: Nat} (t: TreeKEM Bytes l) (ul: List Nat) (pred: Nat → Bool) (pk: Bytes)
  (h: pk ∈ unmergedLeavesResolution (unAddP t pred) (ul.filter pred)):
  pk ∈ unmergedLeavesResolution t ul
:= by
  rw [mem_unmergedLeavesResolution] at h ⊢
  obtain ⟨x, hx, hxt, lp, hlp, rfl⟩ := h
  have hxt': t.containsLeafIndex x := by simpa [Tree.containsLeafIndex] using hxt
  rw [leafAt_unAddP t pred x hxt'] at hlp
  grind

/--
Port of `for_allP_tree_resolution_un_addP_subset`: the resolution of `unAddP t pre` is included in the one of `t`.
MLS* requires `treekem_invariant t` and `treekem_invariant (un_addP t pre)`, which are not needed.
-/
theorem mem_treeResolution_unAddP {l: Nat} (t: TreeKEM Bytes l) (pred: Nat → Bool) (pk: Bytes)
  (h: pk ∈ treeResolution (unAddP t pred)):
  pk ∈ treeResolution t
:= by
  induction t using Tree.leftRightInduction with
  | leaf t =>
    rw [unAddP_zero, mem_treeResolution_zero] at h
    rw [mem_treeResolution_zero]
    grind
  | node t ihl ihr =>
    have := unAddP_left_right t pred
    rw [mem_treeResolution_succ] at h ⊢
    rcases h with ⟨kp, hkp, h⟩ | ⟨hkp, h⟩
    · rw [this.2.2] at hkp
      obtain ⟨kp', hkp', rfl⟩ := Option.map_eq_some_iff.mp hkp
      exact .inl ⟨kp', hkp', h.imp id (mem_unmergedLeavesResolution_unAddP t _ pred pk)⟩
    · rw [this.2.2, Option.map_eq_none_iff] at hkp
      grind

end Resolution

section NodeKeyGoodWeak

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/-- Port of `node_key_good_weak`. -/
@[expose]
public
def NodeKeyGoodWeak {l: Nat} (tr: ProofTrace) (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (pk: Bytes): Prop :=
  MultiEncryptWithLabelPreStrongOne tr (nodeSkLabel t groupId) pk

omit [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace] in
/-- `MultiEncryptWithLabelPreStrongOne` holds for more secret labels. -/
theorem MultiEncryptWithLabelPreStrongOne_of_canFlow (tr: ProofTrace) (randLabel randLabel': Label) (pk: Bytes)
  (hflow: randLabel'.canFlow randLabel tr.erase) (h: MultiEncryptWithLabelPreStrongOne tr randLabel pk):
  MultiEncryptWithLabelPreStrongOne tr randLabel' pk
:= by
  obtain ⟨hinv, hpk, husg⟩ := h
  exact ⟨hinv, canFlowTrans _ _ _ _ hflow hpk, husg.imp_right (canFlowTrans _ _ _ _ hflow)⟩

/-- The public keys that are good for a child are good for its parent (the label of the parent flows to the one of the child). -/
theorem NodeKeyGoodWeak_left_right {l: Nat} (tr: ProofTrace) (t: TreeSync Bytes tkt (l+1)) (groupId: MlsBytes Bytes) (pk: Bytes)
  (h: NodeKeyGoodWeak tr t.left groupId pk ∨ NodeKeyGoodWeak tr t.right groupId pk):
  NodeKeyGoodWeak tr t groupId pk
:= by
  rw [NodeKeyGoodWeak, nodeSkLabel, nodeSkLabelAux_left_right]
  rcases h with h | h
  · exact MultiEncryptWithLabelPreStrongOne_of_canFlow tr _ _ _ (Label.joinCanFlowLeft _ _ _) h
  · exact MultiEncryptWithLabelPreStrongOne_of_canFlow tr _ _ _ (Label.joinCanFlowRight _ _ _) h

/-- `NodeKeyGoodWeak_left_right`, for the child for any leaf index `li`. -/
theorem NodeKeyGoodWeak_of_child {l: Nat} (tr: ProofTrace) (t: TreeSync Bytes tkt (l+1)) (groupId: MlsBytes Bytes) (li: Nat)
  (pk: Bytes) (h: NodeKeyGoodWeak tr (t.child li) groupId pk):
  NodeKeyGoodWeak tr t groupId pk
:= by
  apply NodeKeyGoodWeak_left_right
  rw [Tree.child_eq_left_right] at h
  split at h <;> simp [h]

/-- The node key properties of a leaf or a node give its `NodeKeyGoodWeak`. -/
theorem NodeKeyGoodWeak_of_NodeKeyGood {l: Nat} (tr: ProofTrace) (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes)
  (h: NodeKeyGood tr t groupId):
  NodeKeyGoodWeak tr t groupId (getNodeContent t)
:= by
  obtain ⟨hinv, hflow, husg⟩ := h
  apply MultiEncryptWithLabelPreStrongOne_of_canFlow tr (nodeSkLabelCanon t groupId) _ _
    (nodeSkLabel_canFlow_nodeSkLabelCanon t groupId tr.erase)
  exact ⟨hinv, hflow, husg.imp_left (·.1)⟩

/--
Port of `path_secret_flows_to_leaf_at`.
MLS* requires `li: leaf_index l i` (here `hli`), and `Some? (leaf_at tk li)` (here `hlk`).
-/
theorem nodeKeyGoodWeak_leafAt {l: Nat} (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l) (li: Nat)
  (groupId: MlsBytes Bytes) (tr: ProofTrace) (lk: TreeKEMLeaf Bytes)
  (hgood: AllTreeKeysGood ts groupId tr) (hlk: leafAt tk li = some lk) (hrel: treesyncTreekemRel ts tk)
  (hli: ts.containsLeafIndex li):
  NodeKeyGoodWeak tr ts groupId lk.publicKey
:= by
  subst hrel
  induction ts using Tree.childInduction li with
  | leaf ts =>
    rw [AllTreeKeysGood_zero] at hgood
    rw [leafAt_zero] at hlk
    simp only [leafContent_treesyncToTreekem, Option.map_eq_some_iff] at hlk
    obtain ⟨ln, hln, rfl⟩ := hlk
    have := NodeKeyGoodWeak_of_NodeKeyGood tr ts groupId (hgood (by simp [nodeNotBlank_zero, hln]))
    simpa [getNodeContent_zero, hln] using this
  | node ts ih =>
    rw [AllTreeKeysGood_succ _ _ _ li] at hgood
    rw [leafAt_succ, child_treesyncToTreekem] at hlk
    exact NodeKeyGoodWeak_of_child tr ts groupId li _ (ih hgood.2.1 (Tree.mem_child_self ts hli) hlk)

/--
Port of `path_secret_flows_to_unmerged_leaves_resolution`.
MLS* requires `for_allP (unmerged_leaf_exists tk) unmerged_leaves`, which is not needed.
-/
theorem nodeKeyGoodWeak_unmergedLeavesResolution {l: Nat} (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l)
  (unmergedLeaves: List Nat) (groupId: MlsBytes Bytes) (tr: ProofTrace)
  (hgood: AllTreeKeysGood ts groupId tr) (hrel: treesyncTreekemRel ts tk):
  ∀ pk ∈ unmergedLeavesResolution tk unmergedLeaves, NodeKeyGoodWeak tr ts groupId pk
:= by
  intro pk hpk
  rw [mem_unmergedLeavesResolution] at hpk
  obtain ⟨x, -, hx, lp, hlp, rfl⟩ := hpk
  exact nodeKeyGoodWeak_leafAt ts tk x groupId tr lp hgood hlp hrel (by grind [Tree.containsLeafIndex, treesyncTreekemRel])

/--
Port of `path_secret_flows_to_tree_resolution`.
MLS* requires `treekem_invariant tk`, which is not needed.
-/
public
theorem nodeKeyGoodWeak_treeResolution {l: Nat} (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l)
  (groupId: MlsBytes Bytes) (tr: ProofTrace)
  (hgood: AllTreeKeysGood ts groupId tr) (hrel: treesyncTreekemRel ts tk):
  ∀ pk ∈ treeResolution tk, NodeKeyGoodWeak tr ts groupId pk
:= by
  subst hrel
  induction ts using Tree.leftRightInduction with
  | leaf ts =>
    -- the resolution of a leaf is its public key
    intro pk hpk
    rw [mem_treeResolution_zero] at hpk
    obtain ⟨lp, hlp, rfl⟩ := hpk
    exact nodeKeyGoodWeak_leafAt ts _ ts.position groupId tr lp hgood
      (by rwa [leafAt_zero]) rfl ts.containsLeafIndex_position
  | node ts ihl ihr =>
    intro pk hpk
    have hgood' := (AllTreeKeysGood_left_right ts groupId tr).mp hgood
    rw [mem_treeResolution_succ, nodeContent_treesyncToTreekem, left_treesyncToTreekem, right_treesyncToTreekem] at hpk
    rcases hpk with ⟨kp, hkp, hpk⟩ | ⟨hkp, hpk⟩
    · -- the resolution of a non-blank node is its public key and the public keys of its unmerged leaves
      obtain ⟨pn, hpn, rfl⟩ := Option.map_eq_some_iff.mp hkp
      rcases hpk with rfl | hpk
      · have := NodeKeyGoodWeak_of_NodeKeyGood tr ts groupId (hgood'.1 (by simp [nodeNotBlank_succ, hpn]))
        simpa [getNodeContent_succ, hpn, treesyncToTreekemNode] using this
      · exact nodeKeyGoodWeak_unmergedLeavesResolution ts _ _ groupId tr hgood rfl pk hpk
    · -- the resolution of a blank node is the resolution of its children
      exact NodeKeyGoodWeak_left_right tr ts groupId pk (hpk.imp (ihl hgood'.2.1 pk) (ihr hgood'.2.2 pk))

end NodeKeyGoodWeak

/-! ## Encryption of the path secrets -/

section Encrypt

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

/-- Port of `pathkem_good`. -/
@[expose]
public
def PathkemGood {l: Nat} (p: PathKEM Bytes l) (tr: ProofTrace): Prop :=
  (PathKEM.mf l).wf (Bytes.Publishable · tr) p

/--
Port of `encrypt_path_secrets_entropy_ghost_data`.
The TreeKEM tree `tk` is the (un-added) tree given to `encryptPathSecrets` (MLS*'s `un_addP tk pre`),
and only the nodes with a path secret consume randomness (MLS*'s `forget_path_secrets`).
The leaf index of the path (implicit in MLS*) is `li`.
-/
@[expose]
public
def encryptPathSecretsEntropyGhostData: {l: Nat} → TreeSync Bytes tkt l → TreeKEM Bytes l → (li: Nat) →
  PathSecrets Bytes l → MlsBytes Bytes → RandomnessGhostData
  | _, _, _, _, .leaf _, _ => []
  | _, ts, tk, li, .node opn pNext, groupId =>
    (if opn.isSome then
      multiEncryptWithLabelEntropyGhostData (treeResolution (tk.sibling li)) (nodeSkLabel (ts.sibling li) groupId)
    else []) ++
    encryptPathSecretsEntropyGhostData (ts.child li) (tk.child li) li pNext groupId

/-- Port of `path_secret_good_for_joiner`. MLS*'s `match leaf_at tree leaf_ind` is an `Option.map`. -/
@[expose]
public
def PathSecretGoodForJoiner (tr: ProofTrace) {l: Nat} (tree: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes)
  (leafInd: Nat) (pathSecret: Bytes): Prop
:=
  tree.containsLeafIndex leafInd ∧
  pathSecret.KnowableBy (((leafAt tree leafInd).map (nodeSkLabelAuxLeaf · groupId .yesCommitter leafInd)).getD Label.secret) tr ∧
  ∃ data, pathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr

/-- Port of `path_secrets_good_for_joiners`. -/
@[expose]
public
def PathSecretsGoodForJoiners (tr: ProofTrace) {l: Nat} (tree: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes):
  List Nat → List Bytes → Prop
  | [], [] => True
  | hLi :: tLi, hPs :: tPs =>
    PathSecretGoodForJoiner tr tree groupId hLi hPs ∧ PathSecretsGoodForJoiners tr tree groupId tLi tPs
  | _, _ => False

/-- A path secret flows to the label of the sibling of its node, which does not contain the committer. -/
theorem PathSecretIsCorrect.canFlow_sibling (committer: Participant) (committerLeafPk: Bytes) (isAtRoot: Bool)
  (pathSecret: Bytes) {l: Nat} (t: TreeSync Bytes tkt (l+1)) (groupId: MlsBytes Bytes) (li: Nat) (tr: ProofTrace)
  (h: PathSecretIsCorrect committer committerLeafPk isAtRoot pathSecret t groupId li tr):
  (pathSecret.label tr).canFlow (nodeSkLabel (t.sibling li) groupId) tr.erase
:= by
  apply canFlowTrans _ _ _ _ (canFlowTrans _ _ _ _ h.2.1.1 (Label.joinCanFlowRight _ _ _))
  rw [← nodeSkLabelNocommitter_succ t groupId li,
    (nodeSkLabel_eq_of_not_mem (t.sibling li) groupId li (Tree.not_mem_sibling_self t li)).1]
  exact Label.joinCanFlowRight _ _ _

/-- A path secret, of a path whose leaf index is not in a subtree, flows to the labels of the leaves of the subtree. -/
theorem PathSecretIsCorrect.knowableBy_leaf (committer: Participant) (committerLeafPk: Bytes) (isAtRoot: Bool)
  (pathSecret: Bytes) {l: Nat} (t: TreeSync Bytes tkt l) (groupId: MlsBytes Bytes) (li leafLi: Nat) (tr: ProofTrace)
  (h: PathSecretIsCorrect committer committerLeafPk isAtRoot pathSecret t groupId li tr)
  (hli: t.containsLeafIndex leafLi) (hne: leafLi ≠ li):
  pathSecret.KnowableBy (((leafAt t leafLi).map (nodeSkLabelAuxLeaf · groupId .yesCommitter leafLi)).getD Label.secret) tr
:= by
  obtain ⟨hinv, hlabel, -⟩ := h
  refine ⟨hinv, ?_⟩
  cases hln: leafAt t leafLi with
  | none => exact Label.secret.canFlow _ _
  | some ln =>
    simp only [Option.map_some]
    apply canFlowTrans _ _ _ _ (canFlowTrans _ _ _ _ hlabel.1 (Label.joinCanFlowRight _ _ _))
    rw [← (nodeSkLabelAuxLeaf_of_ne ln groupId li leafLi hne).1]
    exact nodeSkLabelAux_canFlow_leaf t groupId _ leafLi ln _ hli hln

/--
Port of `get_path_secret_of_added_leaf_proof`.
The function takes the TreeKEM tree `tk` of the path (see `getPathSecretOfAddedLeaf`), related to `ts`.
MLS* requires `li: leaf_index l i` (here `hli`).
-/
public
theorem getPathSecretOfAddedLeaf_proof (me: Participant) (isAtRoot: Bool) {l: Nat}
  (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l) (li: Nat) (p: PathSecrets Bytes l) (leafLi: Nat)
  (groupId: MlsBytes Bytes) (tr: ProofTrace) (pathSecret: Bytes)
  (h: getPathSecretOfAddedLeaf tk li p leafLi = .success pathSecret)
  (hrel: treesyncTreekemRel ts tk) (hli: ts.containsLeafIndex li)
  (hp: PathSecretsAreCorrect me isAtRoot ts li groupId p tr):
  PathSecretGoodForJoiner tr ts groupId leafLi pathSecret
:= by
  subst hrel
  induction p generalizing isAtRoot with
  | leaf => exact (getPathSecretOfAddedLeaf_zero _ li _ leafLi pathSecret h).elim
  | node opn pNext ih =>
    obtain ⟨hleafLi, hchild, hsibling⟩ := getPathSecretOfAddedLeaf_node _ li opn pNext leafLi pathSecret h
    rw [child_treesyncToTreekem] at hchild hsibling
    have hleafLi': ts.containsLeafIndex leafLi := by simpa [Tree.containsLeafIndex] using hleafLi
    by_cases hc: (ts.child li).containsLeafIndex leafLi
    · -- the added leaf is in the child: its path secret is in the rest of the path
      have hc': (treesyncToTreekem (ts.child li)).containsLeafIndex leafLi := by simpa [Tree.containsLeafIndex] using hc
      have hp': PathSecretsAreCorrect me (isAtRoot && opn.isNone) (ts.child li) li groupId pNext tr := by
        cases opn <;> simpa using hp.2
      have := ih (h := hchild hc') (hli := Tree.mem_child_self ts hli) (hp := hp')
      exact ⟨hleafLi', by simpa [leafAt_succ ts leafLi, Tree.child_eq_of_mem_child ts hc] using this.2⟩
    · -- the added leaf is in the sibling: its path secret is the one of this node
      have hc': ¬ (treesyncToTreekem (ts.child li)).containsLeafIndex leafLi := by simpa [Tree.containsLeafIndex] using hc
      obtain rfl := hsibling hc'
      obtain ⟨hps, -⟩ := hp
      have hne: leafLi ≠ li := by
        grind
      exact ⟨hleafLi', hps.knowableBy_leaf _ _ _ _ ts groupId li leafLi tr hleafLi' hne, hps.2.2.1⟩

/--
Port of `get_path_secret_of_added_leaves_proof`.
MLS* requires the tree to be the whole tree (`l 0`) and `is_at_root = true`, which are not needed;
MLS* requires `li: leaf_index l 0` (here `hli`).
-/
public
theorem getPathSecretOfAddedLeaves_proof (me: Participant) (isAtRoot: Bool) {l: Nat}
  (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l) (li: Nat) (p: PathSecrets Bytes l) (leafIndices: List Nat)
  (groupId: MlsBytes Bytes) (tr: ProofTrace) (pathSecrets: List Bytes)
  (h: getPathSecretOfAddedLeaves tk li p leafIndices = .success pathSecrets)
  (hrel: treesyncTreekemRel ts tk) (hli: ts.containsLeafIndex li)
  (hp: PathSecretsAreCorrect me isAtRoot ts li groupId p tr):
  PathSecretsGoodForJoiners tr ts groupId leafIndices pathSecrets
:= by
  induction leafIndices generalizing pathSecrets with
  | nil =>
    simp only [getPathSecretOfAddedLeaves, List.mapM_nil, Result.pure_eq_success] at h
    simp [← h, PathSecretsGoodForJoiners]
  | cons x leafIndices ih =>
    simp only [getPathSecretOfAddedLeaves, List.mapM_cons, Result.bind_eq_success, Result.pure_eq_success] at h
    obtain ⟨ps, h1, pss, h2, rfl⟩ := h
    exact ⟨getPathSecretOfAddedLeaf_proof me isAtRoot ts tk li p x groupId tr ps h1 hrel hli hp, ih pss h2⟩

variable [HasMlsTreekemInvariants]

/--
Port of `encrypt_path_secrets_pub_proof`.
MLS* requires `treekem_invariant tk` and `treekem_invariant (un_addP tk pre)`, which are not needed.
-/
public
theorem encryptPathSecrets_pub_proof (me: Participant) (isAtRoot: Bool) {l: Nat}
  (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l) (li: Nat) (p: PathSecrets Bytes l)
  (groupContext: GroupContext Bytes) (groupId: MlsBytes Bytes) (pre: Nat → Bool) (rand: Randomness Bytes) (tr: ProofTrace)
  (updatePath: PathKEM Bytes l) (priv: TreeKEMPriv Bytes l)
  (h: encryptPathSecrets (unAddP tk pre) li p groupContext rand = .success (updatePath, priv))
  (hrel: treesyncTreekemRel ts tk)
  (hp: PathSecretsAreCorrect me isAtRoot ts li groupId p tr)
  (hgood: AllTreeKeysGood ts groupId tr)
  (hgc: GroupContext.mf.wf (Bytes.Invariant · tr) groupContext)
  (hrand: RandomnessHasGhostData tr rand (encryptPathSecretsEntropyGhostData ts (unAddP tk pre) li p groupId)):
  PathkemGood updatePath tr
:= by
  subst hrel
  have hctx := (pred_serializeNE_iff GroupContext.mf (Bytes.Invariant · tr) groupContext).2 (by simpa using hgc)
  induction p generalizing isAtRoot rand with
  | leaf leafIkm =>
    obtain ⟨rfl, -⟩ := encryptPathSecrets_leaf _ li leafIkm groupContext rand updatePath priv h
    obtain ⟨hinv, -, -⟩ := hp
    simp only [PathkemGood, Path.mf.wf_leaf, TreeKEMLeaf.mf.wf_eq]
    exact hpkePk_publishable _ tr hinv
  | node opn pNext ih =>
    have := unAddP_succ (treesyncToTreekem ts) li pre
    rw [child_treesyncToTreekem, sibling_treesyncToTreekem] at this
    have hgood' := (AllTreeKeysGood_succ ts groupId tr li).mp hgood
    cases opn with
    | none =>
      obtain ⟨resNext, privNext, h1, rfl, rfl⟩ := encryptPathSecrets_node_none _ li pNext groupContext rand updatePath priv h
      rw [this.1] at h1
      obtain ⟨-, hp⟩ := hp
      simp only [encryptPathSecretsEntropyGhostData, Option.isSome_none, Bool.false_eq_true, ite_false, List.nil_append,
        this.1] at hrand
      simp only [PathkemGood, Path.mf.wf_node]
      exact ⟨by simp, ih (ts := ts.child li) (isAtRoot := isAtRoot) (rand := rand) (priv := privNext)
        (h := h1) (hp := hp) (hgood := hgood'.2.1) (hrand := hrand)⟩
    | some ps =>
      obtain ⟨randCur, randNext, resNext, privNext, ciphertexts, sk, pk, hsplit, h1, hcts, hderive, upn, hpk, hupn, rfl, rfl⟩ :=
        encryptPathSecrets_node_some _ li ps pNext groupContext rand updatePath priv h
      rw [this.1] at h1
      rw [this.2.1] at hsplit hcts
      obtain ⟨hps, hp⟩ := hp
      simp only [encryptPathSecretsEntropyGhostData, Option.isSome_some, this.1, this.2.1] at hrand
      obtain ⟨hrandCur, hrandNext⟩ := RandomnessHasGhostData.split tr _ rand randCur randNext _ _ hrand
        (by simp [multiEncryptWithLabelEntropyGhostData, length_multiEncryptWithLabelEntropyLengths]) hsplit
      -- the ciphertexts: the path secret is encrypted for the resolution of the sibling, whose keys are good
      have hpks: ∀ pk ∈ treeResolution (unAddP (treesyncToTreekem (ts.sibling li)) pre), NodeKeyGoodWeak tr (ts.sibling li) groupId pk :=
        fun pk hpk => nodeKeyGoodWeak_treeResolution (ts.sibling li) _ groupId tr hgood'.2.2 rfl pk (mem_treeResolution_unAddP _ pre pk hpk)
      have hcts' := multiEncryptWithLabel_weak_proof _ _ ps randCur (nodeSkLabel (ts.sibling li) groupId) tr ciphertexts hcts
        ⟨hpks, hrandCur, hctx, hps.1, hps.canFlow_sibling, (mlsHpkeUpdatepathnodePred_pred _ _ _).2 hps.2.2.1⟩
      -- the public key
      have hnodePk := (deriveKeypairFromPathSecret_proof me _ isAtRoot ps ts groupId li tr sk pk hderive hps).2.1
      simp only [PathkemGood, Path.mf.wf_node, MlsOption.mf.wf_eq, UpdatePathNode.mf.wf_eq, hpk, hupn]
      exact ⟨⟨hnodePk, hcts'⟩, ih (ts := ts.child li) (isAtRoot := false) (rand := randNext) (priv := privNext)
        (h := h1) (hp := hp) (hgood := hgood'.2.1) (hrand := hrandNext)⟩

/-- Port of `encrypt_path_secrets_priv_proof`. MLS* requires `treekem_invariant tk`, which is not needed. -/
public
theorem encryptPathSecrets_priv_proof (me: Participant) (isAtRoot: Bool) {l: Nat}
  (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l) (li: Nat) (p: PathSecrets Bytes l)
  (groupContext: GroupContext Bytes) (groupId: MlsBytes Bytes) (rand: Randomness Bytes) (tr: ProofTrace)
  (updatePath: PathKEM Bytes l) (priv: TreeKEMPriv Bytes l)
  (h: encryptPathSecrets tk li p groupContext rand = .success (updatePath, priv))
  (hp: PathSecretsAreCorrect me isAtRoot ts li groupId p tr):
  TreekemPrivStatePred tr me priv ∧ priv.getPathLeaf = p.getPathLeaf
:= by
  induction p generalizing isAtRoot rand with
  | leaf leafIkm =>
    obtain ⟨-, rfl⟩ := encryptPathSecrets_leaf _ li leafIkm groupContext rand updatePath priv h
    obtain ⟨hinv, hlabel, husg⟩ := hp
    exact ⟨⟨hinv, hlabel.1, husg⟩, rfl⟩
  | node opn pNext ih =>
    cases opn with
    | none =>
      obtain ⟨resNext, privNext, h1, rfl, rfl⟩ := encryptPathSecrets_node_none _ li pNext groupContext rand updatePath priv h
      obtain ⟨-, hp⟩ := hp
      obtain ⟨ih1, ih2⟩ := ih (isAtRoot := isAtRoot) (ts := ts.child li) (tk := tk.child li) (rand := rand) (h := h1) (hp := hp)
      exact ⟨⟨ih1, by simp⟩, ih2⟩
    | some ps =>
      obtain ⟨randCur, randNext, resNext, privNext, ciphertexts, sk, pk, -, h1, -, hderive, upn, -, -, rfl, rfl⟩ :=
        encryptPathSecrets_node_some _ li ps pNext groupContext rand updatePath priv h
      obtain ⟨hps, hp⟩ := hp
      obtain ⟨ih1, ih2⟩ := ih (isAtRoot := false) (ts := ts.child li) (tk := tk.child li) (rand := randNext) (h := h1) (hp := hp)
      have hsk := (deriveKeypairFromPathSecret_proof me _ isAtRoot ps ts groupId li tr sk pk hderive hps).1
      refine ⟨⟨ih1, ?_⟩, ih2⟩
      simp only [Option.mem_def, Option.some.injEq, forall_eq', Path.getPathLeaf, ih2]
      exact hsk.isNodeSkForLeafPk

end Encrypt

/-! ## Decryption of the path secrets -/

section Decrypt

variable [HasSymbolicInvariants] [HasTreeKEMExecTrace]

/-- Port of `decoded_path_secret_good`. -/
@[expose]
public
def DecodedPathSecretGood (me: Participant) (myLeafPk pathSecret: Bytes) (tr: ProofTrace): Prop :=
  pathSecret.Invariant tr ∧
  (pathSecret.label tr).canFlow (nodeKeyLabel me myLeafPk) tr.erase ∧
  ∃ data, pathSecret.HasUsage (Usage.kdfExpandKey "MLS.PathSecret" data) tr

/-- Port of `pathkem_good_weak`. -/
@[expose]
public
def PathkemGoodWeak {l: Nat} (p: PathKEM Bytes l) (tr: ProofTrace): Prop :=
  (PathKEM.mf l).wf (Bytes.Invariant · tr) p

/-- Port of `treekem_priv_state_pred_leaf`. -/
theorem TreekemPrivStatePred.leaf (me: Participant) {l: Nat} (pPriv: TreeKEMPriv Bytes l) (tr: ProofTrace)
  (h: TreekemPrivStatePred tr me pPriv):
  IsNodeSkForLeafPk tr me (hpkePk pPriv.getPathLeaf) pPriv.getPathLeaf
:= by
  induction pPriv with
  | leaf => exact h
  | node _ pNext ih => exact ih h.1

/--
Port of `get_private_key_proof`.
MLS* requires `treekem_invariant t` and `treekem_priv_invariant t p_priv`, which are not needed.
-/
public
theorem getPrivateKey_proof (me: Participant) {l: Nat} (t: TreeKEM Bytes l) (li: Nat) (pPriv: TreeKEMPriv Bytes l)
  (tr: ProofTrace) (sk: Bytes)
  (h: getPrivateKey t li pPriv = .success sk) (hpriv: TreekemPrivStatePred tr me pPriv):
  IsNodeSkForLeafPk tr me (hpkePk pPriv.getPathLeaf) sk
:= by
  induction pPriv with
  | leaf =>
    obtain ⟨⟩ := getPrivateKey_zero t li _ sk h
    exact hpriv
  | node optSk pNext ih =>
    rcases getPrivateKey_node t li optSk pNext sk h with ⟨-, rfl | rfl⟩ | ⟨-, h'⟩
    · exact TreekemPrivStatePred.leaf me pNext tr hpriv.1
    · exact hpriv.2 sk rfl
    · exact ih (t.child li) h' hpriv.1

variable [HasTreeSyncExecTrace tkt] [HasMlsTreekemInvariants]

/--
Port of `get_path_secret_proof`.
MLS* requires `my_li <> li`, `check_update_path_ciphertexts_lengthes t p_upd`, `path_filtering_weak_ok t p_upd`,
`treekem_invariant t` and `treekem_priv_invariant t p_priv`, which are not needed.
-/
public
theorem getPathSecret_proof (me: Participant) {l: Nat} (t: TreeKEM Bytes l) (myLi li: Nat)
  (pPriv: TreeKEMPriv Bytes l) (pUpd: PathKEM Bytes l) (groupContext: GroupContext Bytes) (tr: ProofTrace)
  (pathSecret: Bytes) (level: Nat)
  (h: getPathSecret t myLi li pPriv pUpd groupContext = .success (pathSecret, level))
  (hgc: GroupContext.mf.wf (Bytes.Invariant · tr) groupContext)
  (hpriv: TreekemPrivStatePred tr me pPriv) (hupd: PathkemGoodWeak pUpd tr):
  DecodedPathSecretGood me (hpkePk pPriv.getPathLeaf) pathSecret tr
:= by
  have hctx := (pred_serializeNE_iff GroupContext.mf (Bytes.Invariant · tr) groupContext).2 (by simpa using hgc)
  induction pPriv with
  | leaf => exact (getPathSecret_zero t myLi li _ pUpd groupContext pathSecret level h).elim
  | node optSk pPrivNext ih =>
    cases pUpd with | node optUpn pUpdNext =>
    simp only [PathkemGoodWeak, Path.mf.wf_node] at hupd
    rcases getPathSecret_node t myLi li optSk pPrivNext optUpn pUpdNext groupContext pathSecret level h with
      ⟨-, h'⟩ | ⟨-, -, upn, myIndex, myCiphertext, sk, rfl, -, hct, hsk, hdec⟩
    · exact ih (t.child li) pUpdNext h' hpriv.1 hupd.2
    · have hsk' := getPrivateKey_proof me _ myLi pPrivNext tr sk hsk hpriv.1
      simp only [MlsOption.mf.wf_eq, UpdatePathNode.mf.wf_eq] at hupd
      have hc := hupd.1.2 myCiphertext (List.mem_of_getElem? hct)
      rw [HpkeCiphertext.mf.wf_eq] at hc
      obtain ⟨⟨hinv, hflow⟩, hor⟩ := decryptWithLabel.Invariant mlsHpkeUpdatepathnodePred "MLS.NodeHpkeKey" BytesLike.empty tr
        sk "UpdatePathNode" _ _ _ pathSecret hdec hsk'.1 hsk'.2.2 hc.1 hctx hc.2 (by simp)
      refine ⟨hinv, canFlowTrans _ _ _ _ hflow hsk'.2.1, ?_⟩
      rcases hor with hpred | hpub
      · exact (mlsHpkeUpdatepathnodePred_pred _ _ _).1 hpred
      · exact ⟨BytesLike.empty, Bytes.HasUsage_public _ _ _ hpub.2⟩

/-- Port of `derive_next_path_secret_proof_weak`. -/
public
theorem deriveNextPathSecret_proof_weak (me: Participant) (myLeafPk pathSecret: Bytes) (tr: ProofTrace) (nextPathSecret: Bytes)
  (h: deriveNextPathSecret pathSecret = .success nextPathSecret)
  (hps: DecodedPathSecretGood me myLeafPk pathSecret tr):
  DecodedPathSecretGood me myLeafPk nextPathSecret tr
:= by
  obtain ⟨hinv, hflow, data, husg⟩ := hps
  obtain ⟨hN, hNUsg, hNLabel⟩ := deriveNextPathSecret_invariant_weak tr pathSecret nextPathSecret data h hinv husg
  exact ⟨hN, canFlowTrans _ _ _ _ hNLabel hflow, hNUsg⟩

/-- Port of `derive_keypair_from_path_secret_proof_weak`. -/
public
theorem deriveKeypairFromPathSecret_proof_weak (me: Participant) (myLeafPk pathSecret: Bytes) (tr: ProofTrace) (sk pk: Bytes)
  (h: deriveKeypairFromPathSecret pathSecret = .success (sk, pk))
  (hps: DecodedPathSecretGood me myLeafPk pathSecret tr):
  IsNodeSkForLeafPk tr me myLeafPk sk
:= by
  obtain ⟨hinv, hflow, data, husg⟩ := hps
  obtain ⟨-, hsk, hskUsg, hskLabel⟩ := deriveKeypairFromPathSecret_invariant tr pathSecret sk pk data h hinv husg
  exact ⟨hsk, canFlowTrans _ _ _ _ hskLabel.1 hflow, hskUsg⟩

/-- Port of `path_apply_path_proof`. -/
public
theorem pathApplyPath_proof (me: Participant) {l: Nat} (t: TreeKEM Bytes l) (li: Nat) (pPriv: TreeKEMPriv Bytes l)
  (pathSecret: Bytes) (pathNodeLevel: Nat) (tr: ProofTrace) (resPriv: TreeKEMPriv Bytes l) (pathSecretN: Bytes)
  (h: pathApplyPath t li pPriv pathSecret pathNodeLevel = .success (resPriv, pathSecretN))
  (hpriv: TreekemPrivStatePred tr me pPriv)
  (hps: DecodedPathSecretGood me (hpkePk pPriv.getPathLeaf) pathSecret tr):
  TreekemPrivStatePred tr me resPriv ∧
  DecodedPathSecretGood me (hpkePk pPriv.getPathLeaf) pathSecretN tr ∧
  resPriv.getPathLeaf = pPriv.getPathLeaf
:= by
  induction pPriv generalizing pathSecretN with
  | leaf => exact (pathApplyPath_zero t li _ pathSecret pathNodeLevel resPriv pathSecretN h).elim
  | node optSk pPrivNext ih =>
    obtain ⟨newPPrivNext, pathSecret', h1, h2⟩ :=
      pathApplyPath_node t li optSk pPrivNext pathSecret pathNodeLevel resPriv pathSecretN h
    have hnext: TreekemPrivStatePred tr me newPPrivNext ∧
        DecodedPathSecretGood me (hpkePk pPrivNext.getPathLeaf) pathSecret' tr ∧
        newPPrivNext.getPathLeaf = pPrivNext.getPathLeaf := by
      split at h1
      · obtain ⟨rfl, rfl⟩ := h1
        exact ⟨hpriv.1, hps, rfl⟩
      · exact ih (t.child li) _ _ h1 hpriv.1 hps
    obtain ⟨hn1, hn2, hn3⟩ := hnext
    split at h2
    · obtain ⟨rfl, rfl⟩ := h2
      exact ⟨⟨hn1, by simp⟩, hn2, hn3⟩
    · obtain ⟨sk, pk, hderive, hnextPs, -, rfl⟩ := h2
      refine ⟨⟨hn1, ?_⟩, deriveNextPathSecret_proof_weak me _ pathSecret' tr pathSecretN hnextPs hn2, hn3⟩
      simp only [Option.mem_def, Option.some.injEq, forall_eq', Path.getPathLeaf, hn3]
      exact deriveKeypairFromPathSecret_proof_weak me _ pathSecret' tr sk pk hderive hn2

end Decrypt

/-! ## Commit secret -/

section Generic

variable {Bytes: Type} [BytesLike Bytes] {tkt: TreeKEMTypes Bytes}

/--
Port of `is_above_treesync_root`.
MLS* requires `li: leaf_index l i` (i.e. `t.containsLeafIndex li`);
otherwise, the predicate follows the path to the leaf closest to `li`.
-/
@[expose]
public
def IsAboveTreesyncRoot {l: Nat} (t: TreeSync Bytes tkt l) (li: Nat): Prop :=
  match t.intoChildSiblingView li with
  | .leaf _ _ => True
  | .node (some pn) _ sibling =>
    pn.unmergedLeaves.val = [] ∧
    pn.parentHash = rootParentHash ∧
    ¬ isTreeEmpty sibling
  | .node none child _ => IsAboveTreesyncRoot child li
termination_by l

theorem IsAboveTreesyncRoot_zero (t: TreeSync Bytes tkt 0) (li: Nat): IsAboveTreesyncRoot t li := by
  rw [IsAboveTreesyncRoot.eq_def]
  grind

theorem IsAboveTreesyncRoot_succ {l: Nat} (t: TreeSync Bytes tkt (l+1)) (li: Nat):
  IsAboveTreesyncRoot t li ↔
    (∀ pn, t.nodeContent = some pn → pn.unmergedLeaves.val = [] ∧ pn.parentHash = rootParentHash ∧ ¬ isTreeEmpty (t.sibling li)) ∧
    (t.nodeContent = none → IsAboveTreesyncRoot (t.child li) li)
:= by
  rw [IsAboveTreesyncRoot.eq_def]
  grind

/--
Port of `find_lca`: the height of the lowest common ancestor of the leaves `li1` and `li2`.
Unlike MLS*, this function takes the tree, and follows the child / sibling view for `li1`
(as `computeLeastCommonAncestorLevel`).
MLS* requires `li1 =!= li2`; otherwise, this function returns `0`.
-/
@[expose]
public
def findLca {Leaf Node: Type} {l: Nat} (t: Tree Leaf Node l) (li1 li2: Nat): Nat :=
  match l, t.intoChildSiblingView li1 with
  | _, .leaf _ _ => 0
  | l+1, .node _ child _ => if child.containsLeafIndex li2 then findLca child li1 li2 else l+1

theorem findLca_succ {Leaf Node: Type} {l: Nat} (t: Tree Leaf Node (l+1)) (li1 li2: Nat):
  findLca t li1 li2 = if (t.child li1).containsLeafIndex li2 then findLca (t.child li1) li1 li2 else l+1
:= by
  rw [findLca.eq_def]
  grind

theorem findLca_le {Leaf Node: Type} {l: Nat} (t: Tree Leaf Node l) (li1 li2: Nat): findLca t li1 li2 ≤ l := by
  induction t using Tree.childInduction li1 with
  | leaf t => rw [findLca.eq_def]; simp
  | node t ih => rw [findLca_succ]; split <;> omega

/-- `findLca` only depends on the position of the tree. -/
public
theorem findLca_eq_of_position_eq {Leaf Node Leaf' Node': Type} {l: Nat} (t: Tree Leaf Node l) (t': Tree Leaf' Node' l)
  (li1 li2: Nat) (hpos: t.position = t'.position):
  findLca t li1 li2 = findLca t' li1 li2
:= by
  induction t using Tree.childInduction li1 with
  | leaf t => rw [findLca.eq_def, findLca.eq_def]; simp
  | node t ih =>
    have hc: (t.child li1).position = (t'.child li1).position := by
      grind [Tree.left_position, Tree.right_position]
    rw [findLca_succ, findLca_succ, ih _ hc]
    simp [Tree.containsLeafIndex, hc]

/-- When the sibling is empty, the non-blank leaves are in the child. -/
theorem containsLeafIndex_child_of_isTreeEmpty_sibling {Leaf Node: Type} {l: Nat} (t: Tree (Option Leaf) (Option Node) (l+1))
  (li li': Nat) (hsib: isTreeEmpty (t.sibling li)) (hli: t.containsLeafIndex li) (hli': t.containsLeafIndex li')
  (hleaf: (leafAt t li').isSome):
  (t.child li).containsLeafIndex li'
:= by
  rcases Tree.child_eq_or_sibling t hli hli' with ⟨h, -⟩ | ⟨h, -⟩
  · exact h
  · exfalso
    rw [leafAt_succ, h, leafAt_of_isTreeEmpty _ _ hsib] at hleaf
    simp at hleaf

end Generic

section GenericCryptoBytes

variable {Bytes: Type} [CryptoBytes Bytes] {tkt: TreeKEMTypes Bytes}

/--
Port of `is_above_treesync_root_apply_path`.
MLS*'s `path_filtering_ok t p` is `hfilter`.
-/
public
theorem isAboveTreesyncRoot_applyPathAux {l: Nat} (t: TreeSync Bytes tkt l) (li: Nat) (p: PathSync Bytes tkt l)
  (res: TreeSync Bytes tkt l)
  (h: applyPathAux t li p rootParentHash.val = .success res) (hfilter: pathFilteringOk t li p):
  IsAboveTreesyncRoot res li
:= by
  induction t using Tree.childInduction li with
  | leaf t => exact IsAboveTreesyncRoot_zero res li
  | node t ih =>
    cases p with | node optExtContent pNext =>
    obtain ⟨newOptContent, newParentParentHash, newChild, h1, h2, rfl⟩ := applyPathAux_node t li optExtContent pNext _ res h
    have hpos := applyPathAux_position _ li pNext _ newChild h2
    have hspec := computeNewNpAndPh_spec optExtContent (t.sibling li) _ newOptContent newParentParentHash h1
    rw [pathFilteringOk_succ, Bool.and_eq_true] at hfilter
    rw [IsAboveTreesyncRoot_succ, Tree.nodeContent_pack_replaceChild _ _ _ _ hpos,
      Tree.sibling_pack_replaceChild _ _ _ _ hpos, Tree.child_pack_replaceChild_of_child_eq_child _ _ _ _ _ hpos rfl]
    grind


end GenericCryptoBytes

section FindLca

variable [HasSymbolicBytes]

/--
Port of `get_path_secret_find_lca_eq`.
MLS* requires `my_li: leaf_index l i` and `li: leaf_index l i` (here `hmyLi` and `hli`),
and `my_li <> li`, `check_update_path_ciphertexts_lengthes t p_upd`, `path_filtering_weak_ok t p_upd`,
`treekem_invariant t` and `treekem_priv_invariant t p_priv`, which are not needed.
-/
public
theorem getPathSecret_findLca_eq {l: Nat} (t: TreeKEM Bytes l) (myLi li: Nat)
  (pPriv: TreeKEMPriv Bytes l) (pUpd: PathKEM Bytes l) (groupContext: GroupContext Bytes) (pathSecret: Bytes) (level: Nat)
  (h: getPathSecret t myLi li pPriv pUpd groupContext = .success (pathSecret, level))
  (hmyLi: t.containsLeafIndex myLi) (hli: t.containsLeafIndex li):
  level = findLca t myLi li
:= by
  induction pPriv with
  | leaf => exact (getPathSecret_zero t myLi li _ pUpd groupContext pathSecret level h).elim
  | node optSk pPrivNext ih =>
    cases pUpd with | node optUpn pUpdNext =>
    rw [findLca_succ]
    rcases getPathSecret_node t myLi li optSk pPrivNext optUpn pUpdNext groupContext pathSecret level h with
      ⟨hc, h'⟩ | ⟨hc, rfl, -⟩
    · grind
    · have: ¬ (t.child myLi).containsLeafIndex li := by
        grind
      grind

/-- `findLca` only depends on the positions of the subtrees. -/
theorem findLca_treesyncToTreekem {l: Nat} (t: TreeSync Bytes tkt l) (li1 li2: Nat):
  findLca (treesyncToTreekem t) li1 li2 = findLca t li1 li2
:= by
  induction t using Tree.childInduction li1 with
  | leaf t => rw [findLca.eq_def, findLca.eq_def]; simp
  | node t ih =>
    rw [findLca_succ, findLca_succ, child_treesyncToTreekem, ih]
    simp [Tree.containsLeafIndex]

end FindLca

section CommitSecret

variable [HasSymbolicInvariants] [HasTreeSyncExecTrace tkt] [HasTreeKEMExecTrace]

variable [HasMlsTreekemInvariants]

/--
Port of `path_apply_path_commit_secret_proof_aux`.
-/
theorem pathApplyPath_commitSecret_proof_aux {l: Nat} (ts: TreeSync Bytes tkt l)
  (pathSecret sk pk: Bytes) (groupId: MlsBytes Bytes) (tr: ProofTrace) (commitSecret: Bytes)
  (h: deriveNextPathSecret pathSecret = .success commitSecret)
  (hflow: (nodeSkLabel ts groupId).canFlow (pk.hpkeSkLabel tr) tr.erase)
  (hderive: deriveKeypairFromPathSecret pathSecret = .success (sk, pk))
  (hroot: IsRootNodePk tr pk):
  (nodeSkLabel ts groupId).canFlow (commitSecret.label tr) tr.erase
:= by
  -- the path secret of the root has the usage of the root (no remaining usage)
  obtain ⟨pathSecret', sk', hderive', hinv, husg⟩ := hroot
  obtain rfl := deriveKeypairFromPathSecret_inj _ _ _ _ _ hderive hderive'
  -- the node private key and the commit secret have the label of the path secret
  obtain ⟨rfl, -, -, hsk⟩ := deriveKeypairFromPathSecret_invariant tr pathSecret sk pk _ hderive hinv husg
  obtain ⟨-, -, hc⟩ := deriveNextPathSecret_invariant tr pathSecret commitSecret [] h hinv husg
  rw [PathSecretUsage.headLabel, Label.join_secret_right] at hc
  rw [hpkeSkLabel_hpkePk] at hflow
  grind [canFlowTrans]

omit [HasMlsTreekemInvariants] in
/-- The root node of a tree above the TreeSync root has no unmerged leaves, and the root parent hash. -/
theorem nodeSkLabelCanon_eq_of_isAboveTreesyncRoot {l: Nat} (ts: TreeSync Bytes tkt (l+1)) (li: Nat) (groupId: MlsBytes Bytes)
  (pn: ParentNode Bytes tkt) (hpn: ts.nodeContent = some pn) (habove: IsAboveTreesyncRoot ts li):
  nodeSkLabelCanon ts groupId = nodeSkLabel ts groupId ∧ getParentHashOf ts = some rootParentHash ∧
  ¬ isTreeEmpty (ts.sibling li)
:= by
  obtain ⟨hul, hph, hsib⟩ := ((IsAboveTreesyncRoot_succ ts li).mp habove).1 pn hpn
  refine ⟨?_, by simp [getParentHashOf_succ, hpn, hph], hsib⟩
  rw [nodeSkLabelCanon, canonicalizeUnmergedLeaves_eq_self]
  · rfl
  · simp [isUnmergedLeavesCanonicalized, unmergedLeavesOf_eq, hpn, hul]

/--
Port of `path_apply_path_commit_secret_proof`.
MLS* requires `li: leaf_index l i` and `committer_li: leaf_index l i` (here `hli` and `hcommitterLi`);
MLS* also requires `li =!= committer_li`, which is not needed.
-/
public
theorem pathApplyPath_commitSecret_proof (me: Participant) {l: Nat} (ts: TreeSync Bytes tkt l) (tk: TreeKEM Bytes l)
  (li: Nat) (pPriv: TreeKEMPriv Bytes l) (pathSecret0: Bytes) (committerLi: Nat) (groupId: MlsBytes Bytes) (tr: ProofTrace)
  (resPriv: TreeKEMPriv Bytes l) (commitSecret: Bytes)
  (h: pathApplyPath tk li pPriv pathSecret0 (findLca tk li committerLi) = .success (resPriv, commitSecret))
  (hpriv: TreekemPrivStatePred tr me pPriv)
  (hps0: DecodedPathSecretGood me (hpkePk pPriv.getPathLeaf) pathSecret0 tr)
  (habove: IsAboveTreesyncRoot ts committerLi) (hcommitter: (leafAt tk committerLi).isSome)
  (hrel: treesyncTreekemRel ts tk) (hgood: AllTreeKeysGood ts groupId tr)
  (hli: ts.containsLeafIndex li) (hcommitterLi: ts.containsLeafIndex committerLi):
  (nodeSkLabel ts groupId).canFlow (commitSecret.label tr) tr.erase
:= by
  subst hrel
  rw [findLca_treesyncToTreekem] at h
  rw [leafAt_treesyncToTreekem, Option.isSome_map] at hcommitter
  induction pPriv generalizing commitSecret with
  | leaf => exact (pathApplyPath_zero _ li _ pathSecret0 _ resPriv commitSecret h).elim
  | @node n optSk pPrivNext ih =>
    obtain ⟨newPPrivNext, pathSecret', h1, h2⟩ := pathApplyPath_node _ li optSk pPrivNext pathSecret0 _ resPriv commitSecret h
    rw [child_treesyncToTreekem] at h1
    rw [sibling_treesyncToTreekem, isTreeEmpty_treesyncToTreekem, nodeContent_treesyncToTreekem] at h2
    have hgood' := (AllTreeKeysGood_succ ts groupId tr li).mp hgood
    by_cases hsib: isTreeEmpty (ts.sibling li)
    · -- the sibling is empty: the committer is in the child, and the root node is blank
      simp only [hsib] at h2
      obtain ⟨rfl, rfl⟩ := h2
      have hc := containsLeafIndex_child_of_isTreeEmpty_sibling ts li committerLi hsib hli hcommitterLi hcommitter
      have hchild := Tree.child_eq_of_mem_child ts hc
      -- the node is blank: otherwise, it would be the root of TreeSync, and its sibling would not be empty
      have hcontent: ts.nodeContent = none := by
        cases hpn: ts.nodeContent with
        | none => rfl
        | some pn =>
          have := ((IsAboveTreesyncRoot_succ ts committerLi).mp habove).1 pn hpn
          grind
      -- the path secret is applied in the child
      have hlevel: findLca (ts.child li) li committerLi ≠ n + 1 := by
        have := findLca_le (ts.child li) li committerLi
        grind
      rw [findLca_succ] at h1
      simp only [hc, ite_true, hlevel] at h1
      rw [nodeSkLabel, nodeSkLabelAux_succ ts groupId _ li, nodeSkLabelAux_of_isTreeEmpty _ _ _ hsib, Label.join_secret_right]
      apply ih (ts.child li) newPPrivNext _ hpriv.1 hps0 _ hgood'.2.1 (Tree.mem_child_self ts hli) hc h1
      · rwa [leafAt_succ, hchild] at hcommitter
      · rw [← hchild]
        exact ((IsAboveTreesyncRoot_succ ts committerLi).mp habove).2 hcontent
    · -- the sibling is not empty: the root node has the commit secret
      simp only [hsib, Bool.false_eq_true] at h2
      obtain ⟨sk, pk, hderive, hnext, hpk, rfl⟩ := h2
      obtain ⟨pn, hpn, rfl⟩: ∃ pn, ts.nodeContent = some pn ∧ pn.content.val = pk := by
        cases hpn: ts.nodeContent <;> simp_all [treesyncToTreekemNode]
      -- the path secret at this level
      have hps': DecodedPathSecretGood me (hpkePk pPrivNext.getPathLeaf) pathSecret' tr := by
        by_cases hlvl: findLca ts li committerLi = n + 1
        · simp only [hlvl, ite_true] at h1
          obtain ⟨-, rfl⟩ := h1
          exact hps0
        · simp only [hlvl, ite_false] at h1
          exact (pathApplyPath_proof me _ li pPrivNext pathSecret0 _ tr newPPrivNext pathSecret' h1 hpriv.1 hps0).2.1
      -- the node key of the root
      obtain ⟨-, hflow, hor⟩ := hgood'.1 (by simp [nodeNotBlank_succ, hpn])
      obtain ⟨hcanon, hph, -⟩ := nodeSkLabelCanon_eq_of_isAboveTreesyncRoot ts committerLi groupId pn hpn habove
      have hcontent: getNodeContent ts = pn.content.val := by simp [getNodeContent_succ, hpn]
      rw [hcontent, hcanon] at hflow hor
      rcases hor with ⟨-, hroot⟩ | hpub
      · exact pathApplyPath_commitSecret_proof_aux ts pathSecret' sk _ groupId tr commitSecret hnext hflow hderive
          (hroot ⟨by omega, hph⟩)
      · exact canFlowTrans _ _ _ _ hpub (Label.pubCanFlow _ _)

end CommitSecret

/-- Port of `committer_exists_tree_apply_path`. MLS* requires `li: leaf_index l i` (here `hli`). -/
public
theorem leafAt_treeApplyPath_self {Bytes: Type} [BytesLike Bytes] {l: Nat} (t: TreeKEM Bytes l) (li: Nat) (p: PathKEM Bytes l)
  (hli: t.containsLeafIndex li):
  leafAt (treeApplyPath t li p) li = some p.getPathLeaf
:= by
  simp [leafAt_treeApplyPath t li p li hli hli]

end MLS.TreeKEM
